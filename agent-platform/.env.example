###############################################################################
# agent-platform - SHARED CONFIGURATION (SPEC.txt Section 5.1)
#
# THIS FILE IS THE SINGLE SOURCE OF THE SHARED VALUES.
# Copy the relevant block into each service's own env file:
#
#   mock-idp/.env                  (optional - defaults are baked in)
#   identity-gateway-web/.env.local
#   identity-gateway-api/.env
#   agent-workspace-web/.env.local
#   agent-workspace-api/.env
#   agent-api/.env
#
# ISSUER, JWKS_URI and AUDIENCE MUST BE BYTE-IDENTICAL IN BOTH APIs.
# If they drift, one app returns 401 and the other does not - which is
# precisely the failure this scaffold exists to surface.
#
# PORTS ARE FIXED. They are baked into CORS rules, CSP frame-ancestors and
# postMessage target origins. Do not renumber them.
###############################################################################


# =============================================================================
# THE SIX SHARED CONTRACT VALUES (SPEC.txt Section 5.1)
# =============================================================================

# consumed by: identity-gateway-web, agent-workspace-web, identity-gateway-api,
#              agent-workspace-api   (i.e. both webs and BOTH APIs)
ISSUER=http://localhost:5000

# consumed by: identity-gateway-api, agent-workspace-api   (BOTH APIs)
JWKS_URI=http://localhost:5000/jwks.json

# consumed by: identity-gateway-web, agent-workspace-web, identity-gateway-api,
#              agent-workspace-api   (both webs and BOTH APIs)
# ONE app registration, ONE audience. Do not create a second one.
AUDIENCE=api://agent-platform

# consumed by: agent-workspace-web  (postMessage target origin + CSP
#              frame-ancestors: only this origin may frame :3001)
GATEWAY_ORIGIN=http://localhost:3000

# consumed by: identity-gateway-web  (iframe src + postMessage target origin)
WORKSPACE_ORIGIN=http://localhost:3001

# consumed by: agent-workspace-api, agent-api
# Server-to-server only. No user identity crosses this boundary.
INTERNAL_SECRET=dev-secret


# =============================================================================
# mock-idp/            port 5000   - local stand-in for Microsoft Entra ID
# -----------------------------------------------------------------------------
# Signs RS256 tokens with keys/private.pem and publishes keys/public.pem at
# /jwks.json. The APIs must not be able to tell it is a mock.
# =============================================================================
PORT=5000
# Emitted as the "iss" claim and by /.well-known/openid-configuration.
ISSUER=http://localhost:5000
# Emitted as the "aud" claim.
AUDIENCE=api://agent-platform
# Token lifetime in SECONDS. 120 on purpose: acceptance test 6 (silent renewal)
# must be observable without waiting.
TOKEN_TTL_SECONDS=120


# =============================================================================
# identity-gateway-web/    port 3000   - Next.js 1  (.env.local)
# -----------------------------------------------------------------------------
# Owns the login, the httpOnly cookie, and the PARENT half of the postMessage
# bridge. Never put the token in localStorage or sessionStorage.
# =============================================================================
IDP_ISSUER=http://localhost:5000
CLIENT_ID=identity-gateway-api
API_AUDIENCE=api://agent-platform
NEXT_PUBLIC_GATEWAY_API=http://localhost:4000
NEXT_PUBLIC_WORKSPACE_ORIGIN=http://localhost:3001


# =============================================================================
# identity-gateway-api/    port 4000   - NestJS 1  -> DATABASE A  (.env)
# -----------------------------------------------------------------------------
# Validates the JWT via JWKS, requires scp "access_as_user", then does the JIT
# find-or-create keyed on (tid, oid). Its own SQLite file. CORS: only :3000.
# =============================================================================
PORT=4000
JWKS_URI=http://localhost:5000/jwks.json
ISSUER=http://localhost:5000
AUDIENCE=api://agent-platform
DB_PATH=./gateway.db
CORS_ORIGIN=http://localhost:3000


# =============================================================================
# agent-workspace-web/     port 3001   - Next.js 2  (.env.local)
# -----------------------------------------------------------------------------
# CHILD half of the postMessage bridge in iframe mode; does its own login in
# standalone mode. Token is held IN MEMORY ONLY.
# =============================================================================
NEXT_PUBLIC_GATEWAY_ORIGIN=http://localhost:3000
NEXT_PUBLIC_WORKSPACE_API=http://localhost:4001
# IdP variables, used ONLY by standalone mode (app/api/auth/*):
IDP_ISSUER=http://localhost:5000
CLIENT_ID=identity-gateway-api
API_AUDIENCE=api://agent-platform


# =============================================================================
# agent-workspace-api/     port 4001   - NestJS 2  -> DATABASE B  (.env)
# -----------------------------------------------------------------------------
# JWKS_URI / ISSUER / AUDIENCE are IDENTICAL to identity-gateway-api above.
# Same src/auth/ folder, unchanged. Different database file. CORS: only :3001.
# =============================================================================
PORT=4001
JWKS_URI=http://localhost:5000/jwks.json
ISSUER=http://localhost:5000
AUDIENCE=api://agent-platform
DB_PATH=./workspace.db
CORS_ORIGIN=http://localhost:3001
AGENT_API_URL=http://localhost:8000
INTERNAL_SECRET=dev-secret


# =============================================================================
# agent-api/               port 8000   - FastAPI, INTERNAL ONLY  (.env)
# -----------------------------------------------------------------------------
# No CORS middleware. Nothing in a browser may reach this service. It accepts a
# request only when X-Internal-Secret matches. The user JWT is never forwarded
# here.
# =============================================================================
INTERNAL_SECRET=dev-secret
