# agent-api/.env   (SPEC.txt Section 5.1)
#
# The ONE value this service reads. Note what is absent: no ISSUER, no
# JWKS_URI, no AUDIENCE, no CORS_ORIGIN. agent-api does not validate user
# tokens because no user token is ever sent to it (SPEC.txt Section 5.4:
# "No user identity crosses this boundary").
INTERNAL_SECRET=dev-secret
