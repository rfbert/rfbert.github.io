# agent-api/.env.example   (SPEC.txt Section 4.6 / 5.1)
#
# Copy this file to .env. The value must be byte-identical to the
# INTERNAL_SECRET in agent-workspace-api/.env - that shared string is the
# entire authentication scheme on this boundary, and it is checked with a
# constant-time comparison in security.py.
#
# consumed by: agent-workspace-api (sends it), agent-api (checks it)
#
# What is deliberately NOT here:
#   ISSUER / JWKS_URI / AUDIENCE - agent-api never sees a user JWT, so it has
#   no reason to know how to validate one (SPEC.txt Section 5.4, Section 8
#   "Do not forward the user JWT to agent-api").
#   CORS_ORIGIN - there is no CORS middleware in this service on purpose.
#   A browser cannot reach it, so there is no origin to allow.
INTERNAL_SECRET=dev-secret
