# =============================================================================
# agent-workspace-api    port 4001    NestJS 2    -> DATABASE B (workspace.db)
#
# SPEC.txt 4.5 / 5.1. Copy this file to .env.
#
# JWKS_URI, ISSUER and AUDIENCE MUST BE BYTE-IDENTICAL to the values in
# identity-gateway-api/.env. If they drift, one API returns 401 and the other
# does not -- precisely the failure this scaffold exists to surface.
#
#   diff <(grep -E '^(JWKS_URI|ISSUER|AUDIENCE)=' ../identity-gateway-api/.env) \
#        <(grep -E '^(JWKS_URI|ISSUER|AUDIENCE)=' .env)
# =============================================================================

PORT=4001

# --- the shared identity contract (identical in BOTH APIs) -------------------
JWKS_URI=http://localhost:5000/jwks.json
ISSUER=http://localhost:5000
AUDIENCE=api://agent-platform

# --- this service's own, NOT shared ------------------------------------------
# DATABASE B. A separate SQLite file from gateway.db, on purpose.
DB_PATH=./workspace.db
# CORS: only agent-workspace-web (:3001) may call this API from a browser.
CORS_ORIGIN=http://localhost:3001

# --- the internal boundary to agent-api (SPEC.txt 5.4) -----------------------
# Server-to-server only. The user's JWT is NEVER forwarded across this call;
# the only credential is the shared secret below, in X-Internal-Secret.
AGENT_API_URL=http://localhost:8000
INTERNAL_SECRET=dev-secret
