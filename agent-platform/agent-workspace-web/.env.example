# =============================================================================
# agent-workspace-web     port 3001     Next.js 2      (copy to .env.local)
#
# SPEC.txt 4.4 / 5.1. The values here are contract values -- they must match
# the other services byte for byte. Copy this file to .env.local.
#
# NEXT_PUBLIC_* is inlined into the browser bundle at BUILD time. Nothing
# secret belongs there, and nothing secret is there: an origin and an API URL.
# =============================================================================

# The ONLY origin allowed to frame this app (CSP frame-ancestors) and the ONLY
# origin the postMessage bridge will talk to, in either direction:
#   child -> parent  targetOrigin
#   parent -> child  accepted event.origin
# Never "*". SPEC.txt 5.3.
NEXT_PUBLIC_GATEWAY_ORIGIN=http://localhost:3000

# agent-workspace-api (NestJS 2, DATABASE B). Every call carries the Bearer
# token and no cookie. :4001 allows exactly this origin (:3001) in CORS.
NEXT_PUBLIC_WORKSPACE_API=http://localhost:4001

# --- STANDALONE MODE ONLY (app/api/auth/*) -----------------------------------
# Used when the app is NOT framed and runs its own OAuth login. In iframe mode
# these are never read: the token arrives over postMessage instead, and the
# workspace touches no cookie at all.
# ONE app registration, ONE audience -- do not invent a second (SPEC.txt 8).
IDP_ISSUER=http://localhost:5000
CLIENT_ID=identity-gateway-api
API_AUDIENCE=api://agent-platform
