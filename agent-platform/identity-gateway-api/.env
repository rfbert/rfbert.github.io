# =============================================================================
# identity-gateway-api    port 4000    NestJS 1    -> DATABASE A (gateway.db)
#
# SPEC.txt 4.3 / 5.1. Copy this file to .env.
#
# JWKS_URI, ISSUER and AUDIENCE MUST BE BYTE-IDENTICAL to the values in
# agent-workspace-api/.env. If they drift, one API returns 401 and the other
# does not -- precisely the failure this scaffold exists to surface.
# =============================================================================

PORT=4000

# --- the shared identity contract (identical in BOTH APIs) -------------------
JWKS_URI=http://localhost:5000/jwks.json
ISSUER=http://localhost:5000
AUDIENCE=api://agent-platform

# --- this service's own, NOT shared ------------------------------------------
# DATABASE A. A separate SQLite file from workspace.db, on purpose.
DB_PATH=./gateway.db
# CORS: only identity-gateway-web (:3000) may call this API from a browser.
CORS_ORIGIN=http://localhost:3000
