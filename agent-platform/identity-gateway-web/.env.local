# identity-gateway-web  --  Next.js 1, port 3000   (SPEC.txt 4.2)
#
# Copy to .env.local. Values must match the root .env.example byte for byte:
# ISSUER / AUDIENCE are part of the shared contract (SPEC.txt 5.1), and the
# origins below are baked into the iframe src and the postMessage targetOrigin.
#
# NEXT_PUBLIC_* are inlined into the browser bundle AT BUILD TIME. Everything
# else stays server-side and is read by the app/api/auth/* route handlers only.

# --- server-side only: the OAuth 2.0 + OIDC client half of the login ---------
IDP_ISSUER=http://localhost:5000
CLIENT_ID=identity-gateway-api
API_AUDIENCE=api://agent-platform

# --- exposed to the browser --------------------------------------------------
# The one API this web app is allowed to send a Bearer token to.
NEXT_PUBLIC_GATEWAY_API=http://localhost:4000
# The iframe src AND the postMessage targetOrigin. Never "*" (SPEC.txt 5.3).
NEXT_PUBLIC_WORKSPACE_ORIGIN=http://localhost:3001
