---
/**
 * The site signature: a quiet row of bits with one corrupted bit caught —
 * a single ochre digit, struck through. One glyph per position (no overlay),
 * so nothing can overlap. On load the catch draws in once; reduced-motion
 * renders the final struck state statically.
 */
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<p
  class:list={['bit-sig font-mono text-sm tracking-[0.35em] text-muted select-none', className]}
  aria-label="A row of binary digits with one corrupted bit caught and struck through"
>
  <span>1</span><span>0</span><span>1</span><span>1</span><span class="bit-caught">1</span><span>0</span><span>1</span><span>0</span><span>0</span>
</p>

<style>
  .bit-caught {
    color: var(--c-accent);
    text-decoration: line-through;
    text-decoration-thickness: 1.5px;
    text-decoration-color: var(--c-accent);
    animation: bit-catch 0.9s ease-out 0.4s both;
  }
  @keyframes bit-catch {
    0% { color: var(--c-ink); text-decoration-color: transparent; }
    100% { color: var(--c-accent); text-decoration-color: var(--c-accent); }
  }
  @media (prefers-reduced-motion: reduce) {
    .bit-caught { animation: none; }
  }
</style>
