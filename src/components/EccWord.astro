---
/**
 * An ECC word you can operate: eight data bits ('R' = 0x52) plus one even-parity
 * check bit, with a live parity readout.
 *
 * Two faults are injectable, and the difference between them is the whole point
 * of the theme:
 *   single — parity disagrees, the fault is caught and corrected.
 *   double — parity agrees again, so one check bit cannot see it. The word is
 *            wrong and looks fine. Real ECC spends extra check bits precisely to
 *            catch this case, and it is the failure mode my research studies.
 *
 * The word itself is a graphic (aria-hidden); the readout carries the state as
 * text. Ships as a static figure — a recorded, corrected hit — so the no-JS
 * frame tells the same story; the script reveals the controls.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;

// 'R' = 0x52 = 01010010 — three 1-bits, so the even-parity check bit is 1.
// True data, not texture.
const DATA = [0, 1, 0, 1, 0, 0, 1, 0];
const PARITY = DATA.reduce((a, b) => a ^ b, 0);
// The static (no-JS) frame's recorded hit. Bits render MSB-first, so the label
// uses hardware numbering (bit 0 = LSB, rightmost) — same as BitExhibit's 31..0.
const HIT = 3;
---

<div class:list={['ecc', className]}>
  <div class="ecc-word" aria-hidden="true">
    {
      DATA.map((b, i) => (
        <span
          class:list={['ecc-bit', b ? 'is-on' : '', i === HIT ? 'is-corrected' : '']}
          data-val={b}
        />
      ))
    }
    <span class="ecc-bit ecc-check ml-1.5" data-val={PARITY} />
  </div>

  <p class="ecc-read" role="status">
    <span class="ecc-word-id">'R' = 0x52</span>
    <span class="js-ecc-msg">bit {7 - HIT} — flipped, corrected</span>
  </p>

  <div class="ecc-controls">
    <button type="button" class="ecc-btn js-ecc-single" hidden>single fault</button>
    <button type="button" class="ecc-btn js-ecc-double" hidden>double fault</button>
    <slot />
  </div>
</div>

<style>
  .ecc-word {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  .ecc-bit {
    position: relative;
    display: block;
    width: 0.75rem;
    height: 0.75rem;
    border: 1.5px solid var(--c-ink);
    transition: background 200ms steps(2), border-color 200ms steps(2);
  }
  .ecc-bit.is-on {
    background: var(--c-ink);
  }
  .ecc-check {
    border-color: var(--c-gold);
    background: var(--c-gold);
  }
  .ecc-check[data-val='0'] {
    background: transparent;
  }
  /* A recorded, corrected hit: the bit sits verified-gold and the strike records
     that it was flipped. Fill still encodes the value. */
  .ecc-bit.is-corrected {
    border-color: var(--c-gold);
    background: var(--c-gold);
  }
  .ecc-bit.is-corrected[data-val='0'] {
    background: transparent;
  }
  .ecc-bit.is-corrected::after {
    content: '';
    position: absolute;
    left: -3px;
    right: -3px;
    top: 50%;
    height: 1.5px;
    background: var(--c-red);
    /* bg-colored rims keep the red strike separated from the gold fill, the same
       underlay treatment the OG mark documents. */
    box-shadow:
      0 1.5px 0 var(--c-bg),
      0 -1.5px 0 var(--c-bg);
    transform: rotate(-45deg);
  }
  /* A live fault, drawn in fault red and showing the INVERTED value. Transient
     only — every cycle ends corrected or scrubbed, never sitting red. */
  .ecc-bit.is-fault {
    border-color: var(--c-red);
    background: var(--c-red);
  }
  .ecc-bit.is-fault[data-val='1'] {
    background: transparent;
  }

  .ecc-read {
    margin: 0.4rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--c-muted);
  }
  .ecc-word-id {
    color: var(--c-muted);
  }
  /* Verdicts colour the readout, never the section grammar. */
  .ecc-read.is-caught .js-ecc-msg {
    color: var(--c-gold-text);
  }
  .ecc-read.is-missed .js-ecc-msg {
    color: var(--c-red-text);
  }

  .ecc-controls {
    margin-top: 0.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
  }
  .ecc-btn {
    display: inline-flex;
    align-items: center;
    min-height: 1.5rem;
    padding: 0 0.5rem;
    border: 1px solid var(--c-line);
    background: transparent;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    line-height: 1;
    color: var(--c-muted);
    cursor: pointer;
    transition: border-color 160ms ease-out, color 160ms ease-out;
  }
  .ecc-btn:hover,
  .ecc-btn:focus-visible {
    border-color: var(--c-gold);
    color: var(--c-ink);
  }
  .ecc-btn[disabled] {
    cursor: default;
    opacity: 0.5;
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('.ecc');
  if (root) {
    const bits = [...root.querySelectorAll<HTMLElement>('.ecc-bit:not(.ecc-check)')];
    const check = root.querySelector<HTMLElement>('.ecc-check')!;
    const read = root.querySelector<HTMLElement>('.ecc-read')!;
    const msg = root.querySelector<HTMLElement>('.js-ecc-msg')!;
    const single = root.querySelector<HTMLButtonElement>('.js-ecc-single')!;
    const double = root.querySelector<HTMLButtonElement>('.js-ecc-double')!;

    // Stored word, read off the markup so the data has one source.
    const stored = bits.map((b) => b.dataset.val === '1');
    const storedParity = stored.reduce((a, b) => a !== b, false);
    // Hardware numbering: bit 0 = LSB = rightmost.
    const num = (i: number) => 7 - i;
    const parityOf = (w: boolean[]) => w.reduce((a, b) => a !== b, false);

    let busy = false;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');

    const bump = (sel: string) =>
      document
        .querySelectorAll(sel)
        .forEach((el) => (el.textContent = String(Number(el.textContent) + 1)));

    const setVerdict = (text: string, state: '' | 'caught' | 'missed') => {
      msg.textContent = text;
      read.classList.toggle('is-caught', state === 'caught');
      read.classList.toggle('is-missed', state === 'missed');
    };

    /** Draw a word: `faults` are live (red), `corrected` carries the record mark. */
    const paint = (word: boolean[], faults: number[], corrected: number[]) => {
      bits.forEach((b, i) => {
        b.dataset.val = word[i] ? '1' : '0';
        b.classList.toggle('is-on', word[i]);
        b.classList.toggle('is-fault', faults.includes(i));
        b.classList.toggle('is-corrected', corrected.includes(i));
      });
      check.dataset.val = storedParity ? '1' : '0';
    };

    const pick = (n: number) => {
      const idx = [...bits.keys()];
      for (let i = idx.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [idx[i], idx[j]] = [idx[j], idx[i]];
      }
      return idx.slice(0, n).sort((a, b) => a - b);
    };

    const inject = (n: 1 | 2) => {
      if (busy) return;
      busy = true;
      single.disabled = true;
      double.disabled = true;

      const hit = pick(n);
      const word = stored.map((v, i) => (hit.includes(i) ? !v : v));
      // A single check bit sees odd error counts only: one flip breaks parity,
      // two flips restore it. That asymmetry is the whole demonstration.
      const detected = parityOf(word) !== storedParity;
      const names = hit.map(num).join(' and ');

      const settle = () => {
        if (n === 1) {
          // Caught: restore the true value and leave the record mark.
          paint(stored, [], hit);
          setVerdict(`bit ${names} — corrected`, 'caught');
          bump('.js-ledger-cor');
        } else {
          // Nothing detected it, so nothing was corrected — scrub back clean.
          paint(stored, [], []);
          setVerdict('one check bit cannot see a double fault', 'missed');
        }
        busy = false;
        single.disabled = false;
        double.disabled = false;
      };

      if (reduced.matches) {
        // Designed final frame only: no transient fault state, no timers.
        settle();
        if (detected) bump('.js-ledger-det');
        return;
      }

      paint(word, hit, []);
      if (detected) {
        setVerdict(`bit ${names} flipped — parity mismatch`, 'missed');
        bump('.js-ledger-det');
      } else {
        setVerdict(`bits ${names} flipped — parity still checks out`, 'missed');
      }
      setTimeout(settle, n === 1 ? 420 : 900);
    };

    // Progressive enhancement: the controls only exist once they can act.
    single.hidden = false;
    double.hidden = false;
    single.addEventListener('click', () => inject(1));
    double.addEventListener('click', () => inject(2));
  }
</script>
