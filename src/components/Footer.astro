---
import { site } from '../data/site';
---

<footer class="w-full border-t border-line">
  <div class="mx-auto flex max-w-4xl flex-wrap items-baseline justify-between gap-x-6 gap-y-2 px-5 py-6 font-sans text-sm text-muted">
    <ul class="flex flex-wrap gap-x-5 gap-y-1 list-none p-0 m-0">
      {
        site.contacts.map((c) => (
          <li>
            <a href={c.href} class="no-underline text-muted hover:text-ink transition-colors">
              {c.label}
            </a>
          </li>
        ))
      }
    </ul>
    <p class="m-0">© 2026 Rodrigo Flores Bertolotti</p>
  </div>
</footer>
