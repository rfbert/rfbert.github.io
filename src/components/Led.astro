---
/** Status LED: 'active' pulses gold (static filled under reduced motion),
    'shipped' sits steady. Always paired with its text label — never color-only. */
interface Props {
  status: 'active' | 'shipped' | 'archived';
  class?: string;
}
const { status, class: className } = Astro.props;
const label = status === 'active' ? 'Active' : status === 'shipped' ? 'Shipped' : 'Archived';
---

<span class:list={['inline-flex items-center gap-1.5 font-mono text-[0.7rem] text-muted', className]}>
  <span class:list={['led', `led-${status}`]} aria-hidden="true"></span>
  {label}
</span>

<style>
  .led {
    display: block;
    width: 0.5rem;
    height: 0.5rem;
    border: 1.5px solid var(--c-gold);
  }
  .led-active {
    background: var(--c-gold);
    animation: led-pulse 2s steps(2) infinite;
  }
  .led-shipped {
    background: var(--c-gold);
  }
  .led-archived {
    border-color: var(--c-line);
    background: transparent;
  }
  @keyframes led-pulse {
    50% {
      background: transparent;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .led-active {
      animation: none;
    }
  }
</style>
