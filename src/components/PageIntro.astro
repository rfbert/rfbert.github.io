---
interface Props {
  title: string;
  lede?: string;
}
const { title, lede } = Astro.props;
---

<header class="mb-8">
  <h1 class="page-title">{title}</h1>
  {lede && <p class="mt-3 max-w-[62ch] text-[1.125rem] text-muted">{lede}</p>}
</header>

<style>
  .page-title {
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -0.02em;
  }
</style>
