---
/** Page title block: Archivo at datasheet width. Section labels stay
    scan-legible English — the metaphor lives in chrome. The lede is scan
    copy, so it is never SEU-eligible. */
interface Props {
  title: string;
  lede?: string;
}
const { title, lede } = Astro.props;
---

<header class="mb-9">
  <h1 class="page-title">{title}</h1>
  {lede && <p class="mt-3 max-w-[62ch] text-[1.125rem] leading-relaxed text-muted">{lede}</p>}
</header>

<style>
  .page-title {
    font-family: var(--font-display);
    font-variation-settings: 'wdth' 106;
    font-size: clamp(1.8rem, 3.6vw, 2.4rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.01em;
  }
</style>
