---
/**
 * A pipeline drawn as a routed trace: one gold pad per stage, joined by wire.
 * JS steps the pads on once as the trace scrolls into view; without JS (or
 * with reduced motion) all pads sit lit. Shared by Projects and Experience.
 */
interface Props {
  caption: string;
  stages: string[];
  ariaLabel: string;
}
const { caption, stages, ariaLabel } = Astro.props;
---

<div
  class="js-trace mt-5 max-w-2xl border border-line px-4 py-4 sm:px-5"
  role="group"
  aria-label={ariaLabel}
>
  <p class="m-0 font-sans text-xs text-muted">{caption}</p>
  <ol class="mt-3 flex flex-wrap items-center gap-y-3 list-none p-0 m-0">
    {
      stages.map((stage, i) => (
        <li class="flex items-center">
          {i > 0 && <span class="trace-wire" aria-hidden="true" />}
          <span class="flex items-center gap-1.5">
            <span class="trace-pad" aria-hidden="true" />
            <span class="font-mono text-[0.72rem] text-ink">{stage}</span>
          </span>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .trace-pad {
    display: block;
    width: 0.6rem;
    height: 0.6rem;
    border: 1.5px solid var(--c-gold);
    background: var(--c-gold);
    transition: background 200ms steps(2);
  }
  .trace-wire {
    display: block;
    width: 1.6rem;
    height: 1.5px;
    margin-inline: 0.5rem;
    background: var(--c-line);
  }
  /* JS stages the power-up; without JS (or with reduced motion) all pads sit lit. */
  .js-trace.trace-armed .trace-pad {
    background: transparent;
  }
</style>

<script>
  // Each pipeline stage's pad steps on once as the trace scrolls into view.
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('.js-trace').forEach((trace) => {
    if (reduced) return;
    trace.classList.add('trace-armed');
    const pads = [...trace.querySelectorAll<HTMLElement>('.trace-pad')];
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        pads.forEach((pad, i) => {
          setTimeout(() => (pad.style.background = 'var(--c-gold)'), 120 * i);
        });
        setTimeout(() => trace.classList.remove('trace-armed'), 120 * (pads.length + 1));
      },
      { threshold: 0.4 }
    );
    io.observe(trace);
  });
</script>
