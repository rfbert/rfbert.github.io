---
/** Typographic scope for rendered markdown content. Long body prose is
    SEU-eligible; everything structural stays exempt. */
---

<div class="prose-scope max-w-[66ch]" data-seu>
  <slot />
</div>

<style>
  .prose-scope :global(p) {
    margin-block: 0.8em;
  }
  .prose-scope :global(ul) {
    margin-block: 0.8em;
    padding-inline-start: 1.1em;
    list-style: square;
  }
  .prose-scope :global(li) {
    margin-block: 0.35em;
    padding-inline-start: 0.2em;
  }
  .prose-scope :global(li::marker) {
    color: var(--c-gold);
  }
  .prose-scope :global(strong) {
    font-weight: 600;
  }
  .prose-scope :global(a) {
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.28em;
    text-decoration-color: var(--c-line);
  }
  .prose-scope :global(a:hover) {
    text-decoration-color: var(--c-gold);
  }
</style>
