---
/**
 * Editorial chrome (winning art direction): a marginalia rail on desktop with the
 * structural rule the content hangs on; a single quiet nav row on mobile.
 * Every page renders inside this shell.
 */
import ThemeToggle from './ThemeToggle.astro';
import { site } from '../data/site';

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---

<div class="mx-auto flex w-full max-w-6xl flex-1 flex-col px-5 lg:px-8">
  <a
    href="#content"
    class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:bg-bg focus:px-3 focus:py-2 font-sans text-sm"
  >
    Skip to content
  </a>

  <!-- Mobile wayfinding: one quiet row -->
  <nav
    class="lg:hidden flex flex-wrap items-baseline gap-x-5 gap-y-1 border-b border-line py-4 font-sans text-sm"
    aria-label="Primary"
  >
    <a href="/" class:list={['inline-block py-1.5 transition-colors', path === '/' ? 'text-ink font-medium' : 'text-muted hover:text-ink']}>Home</a>
    {
      site.nav.map((n) => (
        <a
          href={n.href}
          aria-current={isActive(n.href) ? 'page' : undefined}
          class:list={['inline-block py-1.5 transition-colors', isActive(n.href) ? 'text-ink font-medium' : 'text-muted hover:text-ink']}
        >
          {n.label}
        </a>
      ))
    }
    <span class="ml-auto"><ThemeToggle /></span>
  </nav>

  <div class="flex-1 lg:grid lg:grid-cols-[10.5rem_1fr] lg:gap-12 xl:gap-16">
    <!-- Structural left margin: marginalia rail. Full viewport column while sticky:
         wayfinding at the top, place + theme pinned to the bottom, the emptiness
         between them is the composition. -->
    <header class="hidden lg:flex sticky top-0 h-dvh flex-col self-start pt-10 pb-8" aria-label="Site">
      <a href="/" class="font-sans text-sm font-medium text-ink transition-colors hover:text-accent">
        Home
      </a>
      <nav aria-label="Primary" class="mt-1.5">
        <ul class="space-y-1.5 font-sans text-sm">
          {
            site.nav.map((n) => (
              <li>
                <a
                  href={n.href}
                  aria-current={isActive(n.href) ? 'page' : undefined}
                  class:list={[
                    'transition-colors',
                    isActive(n.href) ? 'text-accent' : 'text-muted hover:text-ink',
                  ]}
                >
                  {n.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <p class="mt-auto pt-10 font-sans text-xs text-muted">Corvallis, Oregon</p>
      <div class="mt-2"><ThemeToggle /></div>
    </header>

    <!-- Main column, hung on the rule -->
    <div id="content" class="flex min-w-0 flex-col pt-8 pb-16 lg:border-l lg:border-line lg:pl-11 lg:pt-10">
      <div class="flex-1">
        <slot />
      </div>

      <footer class="mt-16 border-t border-line pt-5">
        <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 font-sans text-sm text-muted">
          <ul class="flex flex-wrap gap-x-5 gap-y-1 list-none p-0 m-0">
            {
              site.contacts.map((c) => (
                <li>
                  <a href={c.href} class="no-underline text-muted transition-colors hover:text-ink">
                    {c.label}
                  </a>
                </li>
              ))
            }
          </ul>
          <p class="m-0">© 2026 Rodrigo Flores Bertolotti</p>
        </div>
      </footer>
    </div>
  </div>
</div>
