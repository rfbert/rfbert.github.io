---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource/ibm-plex-sans/400.css';
// Preload targets: the nameplate face and the body face are on every page's
// critical path; without preload they only start downloading after the CSS
// resolves, so first paint always swaps. Vite rewrites ?url to the hashed
// asset the CSS itself references, keeping the two in sync.
import archivoWdthUrl from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import plexSans400Url from '@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-400-normal.woff2?url';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-serif/400.css';
import '@fontsource/ibm-plex-serif/400-italic.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** Path of the OG image for this page, e.g. "/og/home.png" */
  ogImage?: string;
  /** Accessible description of the OG card — per-page, like title/description */
  ogAlt?: string;
  /** Keep the page out of search indexes (404) */
  noindex?: boolean;
}

const {
  title = site.title,
  description = site.description,
  ogImage = '/og/home.png',
  ogAlt = 'Card with the name Rodrigo Flores Bertolotti and a caught-bit mark in the SEC-DED site style.',
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageAbs = new URL(ogImage, Astro.site);
// Person schema on the two pages a name-search lands on (home + about):
// recruiter/PI disambiguation.
const hasPersonLd = Astro.url.pathname === '/' || Astro.url.pathname === '/about/';

const personLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': 'https://rfbert.me/#person',
  name: 'Rodrigo Flores Bertolotti',
  jobTitle: 'Undergraduate Researcher',
  affiliation: { '@type': 'CollegeOrUniversity', name: 'Oregon State University' },
  url: 'https://rfbert.me',
  email: 'mailto:rf.bertolotti@gmail.com',
  sameAs: ['https://github.com/rfbert', 'https://www.linkedin.com/in/rodrigo-bertolotti'],
});
---

<!doctype html>
<html lang="en" class="scheme-light dark:scheme-dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={archivoWdthUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={plexSans400Url} as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />
    {/* A noindex page (404) has no canonical URL worth declaring. */}
    {!noindex && <link rel="canonical" href={canonical} />}
    {/* One mark on every surface: SVG where it is supported, a real multi-size
        ICO for the surfaces that silently fall back to /favicon.ico, and a PNG
        for iOS. Without the ICO, anything taking that fallback path got nothing
        and drew its own placeholder. ?v= busts the cache — favicons are cached
        hard, so bump it whenever the mark changes. */}
    <link rel="icon" href="/favicon.svg?v=5" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico?v=5" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=5" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
    {/* Browser-chrome tint = the page background tokens (global.css). The pair
        follows the system scheme; a manual in-page override can't reach it. */}
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f7f9f8" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0f231b" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />
    <meta name="twitter:image:alt" content={ogAlt} />
    {noindex && <meta name="robots" content="noindex" />}
    {hasPersonLd && <script type="application/ld+json" is:inline set:html={personLd} />}
    <script is:inline>
      // Theme: system default + manual override persisted in localStorage. Runs before paint.
      // ?theme=light|dark wins for that page load only (used by automated screenshots/tests).
      // Storage can throw when blocked (hardened/private modes) — fall through to system.
      (() => {
        const q = new URLSearchParams(location.search).get('theme');
        let stored = q === 'light' || q === 'dark' ? q : null;
        if (!stored) {
          try {
            stored = localStorage.getItem('theme');
          } catch {}
        }
        const dark = stored ? stored === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.classList.toggle('dark', dark);
      })();
    </script>
  </head>
  <body class="bg-bg text-ink min-h-dvh flex flex-col">
    <slot />
  </body>
</html>
