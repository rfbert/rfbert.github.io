---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-serif/400.css';
import '@fontsource/ibm-plex-serif/400-italic.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** Path of the OG image for this page, e.g. "/og/home.png" */
  ogImage?: string;
  /** Keep the page out of search indexes (404) */
  noindex?: boolean;
  /** Kept for design-variant routes; chrome now lives in SiteShell */
  bare?: boolean;
}

const {
  title = site.title,
  description = site.description,
  ogImage = '/og/home.png',
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageAbs = new URL(ogImage, Astro.site);
const ogAlt =
  'Card with the name Rodrigo Flores Bertolotti and a caught-bit mark in the SEC-DED site style.';
const isHome = Astro.url.pathname === '/';

// Person schema (home only): recruiter/PI name-search disambiguation.
const personLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': 'https://rfbert.me/#person',
  name: 'Rodrigo Flores Bertolotti',
  jobTitle: 'Undergraduate Researcher',
  affiliation: { '@type': 'CollegeOrUniversity', name: 'Oregon State University' },
  url: 'https://rfbert.me',
  email: 'mailto:rf.bertolotti@gmail.com',
  sameAs: ['https://github.com/rfbert', 'https://www.linkedin.com/in/rodrigo-bertolotti'],
});
---

<!doctype html>
<html lang="en" class="scheme-light dark:scheme-dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {/* A noindex page (404) has no canonical URL worth declaring. */}
    {!noindex && <link rel="canonical" href={canonical} />}
    {/* One mark on every surface: SVG where it is supported, a real multi-size
        ICO for the surfaces that silently fall back to /favicon.ico, and a PNG
        for iOS. Without the ICO, anything taking that fallback path got nothing
        and drew its own placeholder. ?v= busts the cache — favicons are cached
        hard, so bump it whenever the mark changes. */}
    <link rel="icon" href="/favicon.svg?v=3" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico?v=3" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=3" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Rodrigo Flores Bertolotti" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />
    <meta name="twitter:image:alt" content={ogAlt} />
    {noindex && <meta name="robots" content="noindex" />}
    {isHome && <script type="application/ld+json" set:html={personLd} />}
    <script is:inline>
      // Theme: system default + manual override persisted in localStorage. Runs before paint.
      // ?theme=light|dark wins for the session (used by automated screenshots/tests).
      // Storage can throw when blocked (hardened/private modes) — fall through to system.
      (() => {
        const q = new URLSearchParams(location.search).get('theme');
        let stored = q === 'light' || q === 'dark' ? q : null;
        if (!stored) {
          try {
            stored = localStorage.getItem('theme');
          } catch {}
        }
        const dark = stored ? stored === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.classList.toggle('dark', dark);
      })();
    </script>
  </head>
  <body class="bg-bg text-ink min-h-dvh flex flex-col">
    <slot />
  </body>
</html>
