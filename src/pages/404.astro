---
import Base from '../layouts/Base.astro';
import SiteShell from '../components/SiteShell.astro';
---

<Base title="404 — Rodrigo Flores Bertolotti" description="Page not found.">
  <SiteShell>
    <div class="py-16">
      <p class="font-mono text-sm tracking-[0.35em] text-muted" aria-hidden="true">
        4<span class="text-accent">0̶</span>4
      </p>
      <h1 class="mt-4 text-[2rem] font-semibold leading-tight">Page not found</h1>
      <p class="mt-3 max-w-[52ch] text-muted">
        This address doesn't resolve — possibly a flipped bit in the URL.
      </p>
      <p class="mt-6">
        <a
          href="/"
          class="font-sans text-sm underline decoration-line decoration-1 underline-offset-4 hover:decoration-accent"
        >
          Back to the home page
        </a>
      </p>
    </div>
  </SiteShell>
</Base>
