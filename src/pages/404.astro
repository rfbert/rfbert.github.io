---
import Base from '../layouts/Base.astro';
import SiteShell from '../components/SiteShell.astro';
---

<Base title="404 — Rodrigo Flores Bertolotti" description="Page not found." noindex={true}>
  <SiteShell>
    <div class="py-16">
      <p class="font-mono text-sm tracking-[0.35em]" aria-hidden="true">
        4<span class="err-bit">0</span>4
      </p>
      <h1 class="mt-4 text-[2rem] font-semibold leading-tight">Page not found</h1>
      <p class="mt-3 max-w-[56ch] text-muted">
        This address doesn't verify. A double bit flip is detectable but not correctable — the one
        failure the code admits.
      </p>
      <p class="mt-3 font-mono text-xs text-red-text">detected 1 · corrected 0</p>
      <p class="mt-6">
        <a
          href="/"
          class="font-sans text-sm underline decoration-line decoration-1 underline-offset-4 hover:decoration-gold"
        >
          Restore from known-good copy — back to the home page
        </a>
      </p>
    </div>
  </SiteShell>
</Base>

<style>
  /* The only page where fault red stays lit. */
  .err-bit {
    color: var(--c-red-text);
    text-decoration: line-through;
    text-decoration-thickness: 1.5px;
  }
</style>
