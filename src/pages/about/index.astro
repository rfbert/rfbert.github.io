---
import Base from '../../layouts/Base.astro';
import SiteShell from '../../components/SiteShell.astro';
import PageIntro from '../../components/PageIntro.astro';
import { site } from '../../data/site';
---

<Base
  title="About — Rodrigo Flores Bertolotti"
  description="About Rodrigo Flores Bertolotti: CS undergraduate at Oregon State University building production AI, with research on LLM reliability."
  ogImage="/og/about.png"
>
  <SiteShell>
    <PageIntro title="About" />

    <div class="max-w-[68ch] space-y-4">
      <p>
        I'm a computer science undergraduate at Oregon State University. I build AI systems, and
        I'm drawn to LLM reliability: what happens to large language models when the hardware under
        them fails, and how inference can defend itself.
      </p>
      <p>
        This summer I'm building production AI at Mibanco (part of Credicorp, Peru's largest
        financial group): a speech-to-text and LLM-interpretation pipeline on Databricks and Azure
        AI. Before that, at OSU's TRUE (Trustworthy and Responsible) AI Lab, I ran fault-injection
        experiments on 1B–8B models and did the initial investigation and early results on
        decoding-time defenses against bit-flip attacks.
      </p>
      <p>
        I grew up in Lima, Peru, and study CS at Oregon State. I build my own tools, too; the
        latest is an internship agent I use every morning. And I use AI tooling daily, for
        development and for staying organized.
      </p>
    </div>

    <section class="mt-10" aria-labelledby="now">
      <h2 id="now" class="font-sans text-sm font-medium text-muted">Now</h2>
      <div class="mt-3 border-t border-line pt-4 max-w-[68ch]">
        <p>
          <span class="font-mono text-xs text-muted mr-3">Jul 2026</span>
          Interning on the AI team at Mibanco in Lima. Summer 2027 internship applications are next.
        </p>
      </div>
    </section>

    <section class="mt-10" aria-labelledby="edu">
      <h2 id="edu" class="font-sans text-sm font-medium text-muted">Education</h2>
      <div class="mt-3 border-t border-line pt-4 max-w-[68ch] space-y-1.5">
        <p>{site.education.line}</p>
        <p class="font-sans text-sm text-muted">{site.education.coursework}</p>
      </div>
    </section>

    <section class="mt-10" aria-labelledby="recognition">
      <h2 id="recognition" class="font-sans text-sm font-medium text-muted">
        Leadership, awards &amp; certificates
      </h2>
      <ul class="mt-3 border-t border-line pt-4 list-none p-0 m-0 max-w-[68ch] space-y-2.5">
        {
          site.awards.map((a) => (
            <li>
              <p class="font-medium">{a.title}</p>
              <p class="font-sans text-sm text-muted">{a.detail}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-10" aria-labelledby="contact">
      <h2 id="contact" class="font-sans text-sm font-medium text-muted">Contact</h2>
      <ul class="mt-3 border-t border-line pt-4 grid grid-cols-1 gap-x-6 gap-y-3 sm:grid-cols-2 list-none p-0 m-0">
        {
          site.contacts.map((c) => (
            <li class="min-w-0">
              <span class="block font-sans text-xs text-muted">{c.label}</span>
              <a
                href={c.href}
                class="font-mono text-[0.82rem] break-words underline decoration-line decoration-1 underline-offset-4 hover:decoration-accent"
              >
                {c.value}
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </SiteShell>
</Base>
