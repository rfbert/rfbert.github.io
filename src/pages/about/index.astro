---
import Base from '../../layouts/Base.astro';
import SiteShell from '../../components/SiteShell.astro';
import PageIntro from '../../components/PageIntro.astro';
import PinContacts from '../../components/PinContacts.astro';
import PipelineTrace from '../../components/PipelineTrace.astro';
import { site } from '../../data/site';
---

<Base
  title="About — Rodrigo Flores Bertolotti"
  description="About Rodrigo Flores Bertolotti: CS undergraduate at Oregon State University building production AI, with research on LLM reliability."
  ogImage="/og/about.png"
>
  <SiteShell>
    <PageIntro title="About" />

    <div class="max-w-[66ch] space-y-4" data-seu>
      <p>
        I'm a computer science undergraduate at Oregon State University. I build AI systems, and
        I'm drawn to LLM reliability: what happens to large language models when the hardware under
        them fails, and how inference can defend itself.
      </p>
      <p>
        This summer I'm building production AI at Mibanco (part of Credicorp, Peru's largest
        financial group): a speech-to-text and LLM-interpretation pipeline on Databricks and Azure
        AI. Before that, at OSU's TRUE (Trustworthy and Responsible) AI Lab, I ran fault-injection
        experiments on 1B–8B models and contributed data and benchmarks to decoding-time
        defenses against bit-flip attacks.
      </p>
      <p>
        I grew up in Lima, Peru. I build my own tools, too; the latest is an internship agent I
        use every morning. And I use AI tooling daily, for development and for staying organized.
      </p>
    </div>
    <PipelineTrace
      caption="the route so far"
      stages={['Lima, Peru · 12°03′S', 'Corvallis, OR · 44°34′N']}
      ariaLabel="From Lima to Corvallis"
    />

    <section class="mt-10" aria-labelledby="now" data-sec>
      <h2 id="now" class="sec-label">Now</h2>
      <div class="mt-3 border-t border-line pt-4 max-w-[66ch]">
        <p>
          <span class="font-mono text-xs text-muted mr-3">Aug 2026</span>
          Interning on the AI team at Mibanco in Lima. Summer 2027 internship applications are next.
        </p>
      </div>
    </section>

    <section class="mt-10" aria-labelledby="edu" data-sec>
      <h2 id="edu" class="sec-label">Education</h2>
      <div class="mt-3 border-t border-line pt-4 max-w-[75ch] space-y-1.5">
        <p class="font-mono text-[0.82rem] leading-relaxed">{site.education.line}</p>
        <p class="font-sans text-sm text-muted">{site.education.coursework}</p>
      </div>
    </section>

    <section class="mt-10" aria-labelledby="recognition" data-sec>
      <h2 id="recognition" class="sec-label">Leadership, awards &amp; certificates</h2>
      <ul class="mt-3 border-t border-line pt-4 list-none p-0 m-0 max-w-[66ch] space-y-2.5" role="list">
        {
          site.awards.map((a) => (
            <li>
              <p class="font-medium">{a.title}</p>
              <p class="font-sans text-sm text-muted">{a.detail}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-10" aria-labelledby="contact" data-sec>
      <h2 id="contact" class="sec-label">Contact</h2>
      <div class="mt-3 border-t border-line pt-4">
        <PinContacts />
      </div>
    </section>
  </SiteShell>
</Base>

<style>
  .sec-label {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--c-muted);
  }
</style>
