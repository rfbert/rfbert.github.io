---
import Base from '../../layouts/Base.astro';
import SiteShell from '../../components/SiteShell.astro';
import PageIntro from '../../components/PageIntro.astro';
import PinContacts from '../../components/PinContacts.astro';
import { site } from '../../data/site';
---

<Base
  title="About — Rodrigo Flores Bertolotti"
  description="About Rodrigo Flores Bertolotti: CS undergraduate at Oregon State University building production AI, with research on LLM reliability."
  ogImage="/og/about.png"
  ogAlt="About card for Rodrigo Flores Bertolotti with a caught-bit mark in the SEC-DED site style."
>
  <SiteShell>
    <PageIntro title="About" />

    <div class="max-w-[66ch] space-y-4" data-seu>
      <p>
        I grew up in Lima, Peru, and got into computing by automating the small, repetitive parts
        of my own days. That habit — build the tool, then actually keep using it — is still how I
        work.
      </p>
      <p>
        At Oregon State I found the problem I care about most: what happens to large language models
        when the hardware under them fails. At the TRUE (Trustworthy and Responsible) AI Lab I run
        fault-injection experiments on 1B–8B models and benchmark decoding-time defenses against
        bit-flip attacks — the kind of failure that stays invisible until it isn’t.
      </p>
      <p>
        This summer I’m at Mibanco, part of Credicorp, building a speech-to-text and
        LLM-interpretation pipeline on Databricks and Azure AI for integration into production
        workflows. On the side I keep shipping my own tools. The current one reads the internship
        market for me: I specified it, I directed the build, and I decide what it is allowed to
        decide on its own.
      </p>
    </div>

    <section class="mt-10" aria-labelledby="path">
      <h2 id="path" class="sec-label">Path</h2>
      <ol class="timeline mt-4 list-none p-0 m-0" role="list">
        <li>
          <div class="tl-body">
            <span class="tl-pad" aria-hidden="true"></span>
            <time class="tl-date font-mono text-xs text-muted">2023</time>
            <p class="tl-head font-medium">Lima, Peru</p>
            <p class="font-sans text-sm text-muted">
              Organized community donation and food drives reaching 65+ children and families.
            </p>
          </div>
        </li>
        <li>
          <div class="tl-body">
            <span class="tl-pad" aria-hidden="true"></span>
            <time class="tl-date font-mono text-xs text-muted">2024</time>
            <p class="tl-head font-medium">USMP · Oregon State University</p>
            <p class="font-sans text-sm text-muted">
              Mentored and graded a university Python course in Lima, then began my CS degree in
              the Honors College at Oregon State that fall.
            </p>
          </div>
        </li>
        <li>
          <div class="tl-body">
            <span class="tl-pad" aria-hidden="true"></span>
            <time class="tl-date font-mono text-xs text-muted">2025</time>
            <p class="tl-head font-medium">Oregon State University · TRUE AI Lab</p>
            <p class="font-sans text-sm text-muted">
              Finished a Diploma in Artificial Intelligence (final grade 98%), joined the TRUE AI
              Lab through a URSA Engage research award, and made the College of Engineering
              Dean’s List.
            </p>
          </div>
        </li>
        <li>
          <div class="tl-body">
            <span class="tl-pad" aria-hidden="true"></span>
            <time class="tl-date font-mono text-xs text-muted">2026</time>
            <p class="tl-head font-medium">Artificial Intelligence intern · Mibanco (Credicorp)</p>
            <p class="font-sans text-sm text-muted">
              Building a production speech-to-text and LLM-interpretation pipeline in Lima.
            </p>
          </div>
        </li>
      </ol>
    </section>

    <section class="mt-10" aria-labelledby="now">
      <h2 id="now" class="sec-label">Now</h2>
      <div class="mt-3 border-t border-line pt-4 max-w-[66ch]">
        <p>
          <span class="font-mono text-xs text-muted mr-3">Aug 2026</span>
          Interning on the AI team at Mibanco in Lima. Summer 2027 internship applications are next.
        </p>
      </div>
    </section>

    <section class="mt-10" aria-labelledby="edu">
      <h2 id="edu" class="sec-label">Education</h2>
      <div class="mt-3 border-t border-line pt-4 max-w-[75ch] space-y-1.5">
        <p class="font-mono text-[0.82rem] leading-relaxed">{site.education.line}</p>
        <p class="font-sans text-sm text-muted">{site.education.coursework}</p>
      </div>
    </section>

    <section class="mt-10" aria-labelledby="recognition">
      <h2 id="recognition" class="sec-label">Leadership, awards &amp; certificates</h2>
      <ul class="mt-3 border-t border-line pt-4 list-none p-0 m-0 max-w-[66ch] space-y-2.5" role="list">
        {
          site.awards.map((a) => (
            <li>
              <p class="font-medium">{a.title}</p>
              <p class="font-sans text-sm text-muted">{a.detail}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-10" aria-labelledby="contact">
      <h2 id="contact" class="sec-label">Contact</h2>
      <div class="mt-3 border-t border-line pt-4">
        <PinContacts />
      </div>
    </section>
  </SiteShell>
</Base>

<style>
  .sec-label {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--c-muted);
  }

  /* A milestone timeline: gold pads riding a continuous line. The spacing lives
     as padding inside each bordered body, so the rail never breaks between items;
     the last item drops the line so it terminates cleanly. */
  .timeline {
    max-width: 62ch;
  }
  .tl-body {
    position: relative;
    padding-left: 1.5rem;
    padding-bottom: 1.35rem;
    border-left: 1.5px solid var(--c-line);
  }
  .timeline li:last-child .tl-body {
    padding-bottom: 0;
    border-left-color: transparent;
  }
  .tl-pad {
    position: absolute;
    left: -0.34rem;
    top: 0.2rem;
    width: 0.6rem;
    height: 0.6rem;
    border: 1.5px solid var(--c-gold);
    background: var(--c-gold);
  }
  .tl-body p {
    margin: 0;
  }
  .tl-head {
    margin-top: 0.15rem;
  }
</style>
