---
import Base from '../../layouts/Base.astro';
import SiteShell from '../../components/SiteShell.astro';
import PageIntro from '../../components/PageIntro.astro';
import Prose from '../../components/Prose.astro';
import { getCollection, render } from 'astro:content';

const experience = (await getCollection('experience')).sort(
  (a, b) => a.data.order - b.data.order
);
const rendered = await Promise.all(
  experience.map(async (entry) => ({ entry, Content: (await render(entry)).Content }))
);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
---

<Base
  title="Experience — Rodrigo Flores Bertolotti"
  description="Experience: AI intern at Mibanco (Credicorp), undergraduate researcher at OSU's TRUE AI Lab, digital technology assistant at the OSU Foundation."
  ogImage="/og/experience.png"
>
  <SiteShell>
    <PageIntro title="Experience" />

    <ul class="list-none p-0 m-0 space-y-10">
      {
        rendered.map(({ entry, Content }) => (
          <li class="border-t border-line pt-6">
            <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-0.5">
              <h2 class="text-[1.35rem] leading-snug font-semibold">
                {entry.data.organization}
                {entry.data.parent && <span class="font-normal text-muted"> — {entry.data.parent}</span>}
              </h2>
              <span class="font-mono text-xs text-muted">
                {fmt(entry.data.start)}
                {entry.data.end ? `–${fmt(entry.data.end)}` : '–present'}
              </span>
            </div>
            <p class="mt-0.5 font-sans text-sm text-muted">
              {entry.data.role} · {entry.data.location}
            </p>
            {entry.data.stack.length > 0 && (
              <p class="mt-1.5 flex flex-wrap gap-x-4 gap-y-1 font-mono text-xs text-muted">
                {entry.data.stack.map((t) => (
                  <span>{t}</span>
                ))}
              </p>
            )}
            <div class="mt-3">
              <Prose>
                <Content />
              </Prose>
            </div>
          </li>
        ))
      }
    </ul>
  </SiteShell>
</Base>
