---
import Base from '../../layouts/Base.astro';
import SiteShell from '../../components/SiteShell.astro';
import PageIntro from '../../components/PageIntro.astro';
import Prose from '../../components/Prose.astro';
import PipelineTrace from '../../components/PipelineTrace.astro';
import { getCollection, render } from 'astro:content';

const experience = (await getCollection('experience')).sort(
  (a, b) => a.data.order - b.data.order
);
const rendered = await Promise.all(
  experience.map(async (entry) => ({ entry, Content: (await render(entry)).Content }))
);

// Content dates are UTC midnights; format in UTC or the build timezone
// renders every 1st-of-month one month early.
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' });

// Coordinate stamps: biography as measured values (Lima ↔ Corvallis).
const coord = (location: string) =>
  location.includes('Lima') ? '12°03′S' : location.includes('Corvallis') ? '44°34′N' : null;
---

<Base
  title="Experience — Rodrigo Flores Bertolotti"
  description="Experience: AI intern at Mibanco (Credicorp), undergraduate researcher at OSU's TRUE AI Lab, digital technology assistant at the OSU Foundation."
  ogImage="/og/experience.png"
>
  <SiteShell>
    <PageIntro title="Experience" />

    <ul class="list-none p-0 m-0 space-y-0">
      {
        rendered.map(({ entry, Content }) => (
          <li class="border-t border-line py-7 md:grid md:grid-cols-[9.5rem_1fr] md:gap-8" data-sec>
            <!-- Address column: the date range is the region's address in the map -->
            <p class="m-0 font-mono text-xs leading-relaxed text-muted">
              {fmt(entry.data.start)}<br />
              {entry.data.end ? `– ${fmt(entry.data.end)}` : '– present'}
            </p>
            <div class="mt-2 md:mt-0 min-w-0">
              <h2 class="text-[1.35rem] leading-snug font-semibold">
                {entry.data.organization}
                {entry.data.parent && (
                  <span class="font-normal text-muted"> — {entry.data.parent}</span>
                )}
              </h2>
              <p class="mt-0.5 font-sans text-sm text-muted">
                {entry.data.role} · {entry.data.location}
                {coord(entry.data.location) && (
                  <span class="ml-2 font-mono text-xs">{coord(entry.data.location)}</span>
                )}
              </p>
              {entry.data.stack.length > 0 && (
                <p class="mt-1.5 flex flex-wrap gap-x-4 gap-y-1 font-mono text-xs text-muted">
                  {entry.data.stack.map((t) => (
                    <span>{t}</span>
                  ))}
                </p>
              )}
              {entry.id === 'mibanco' && (
                <PipelineTrace
                  caption="recorded audio to production, parallelized on Databricks"
                  stages={['audio', 'ingest', 'speech-to-text', 'LLM interpretation', 'production']}
                  ariaLabel="Speech-to-text pipeline"
                />
              )}
              <div class="mt-3">
                <Prose>
                  <Content />
                </Prose>
              </div>
            </div>
          </li>
        ))
      }
    </ul>
  </SiteShell>
</Base>
