---
import Base from '../layouts/Base.astro';
import SiteShell from '../components/SiteShell.astro';
import EccWord from '../components/EccWord.astro';
import PinContacts from '../components/PinContacts.astro';
import StatusStamp from '../components/StatusStamp.astro';
import Led from '../components/Led.astro';
import { site } from '../data/site';
import { getCollection } from 'astro:content';
import portraitMask from '../assets/portrait-mask.png';

const research = await getCollection('research');
const experience = await getCollection('experience');
const projects = await getCollection('projects');

function must<T>(value: T | undefined, id: string): T {
  if (!value) throw new Error(`Home page: required content entry "${id}" is missing`);
  return value;
}
const bitflip = must(research.find((r) => r.id === 'targeted-bitflip-defense'), 'research/targeted-bitflip-defense');
const crossScale = must(research.find((r) => r.id === 'cross-scale-resilience'), 'research/cross-scale-resilience');
const mibanco = must(experience.find((e) => e.id === 'mibanco'), 'experience/mibanco');
const scout = must(projects.find((p) => p.id === 'internship-scout'), 'projects/internship-scout');
---

<Base ogImage="/og/home.png">
  <SiteShell>
    <!-- Part header: name, degree line, focus, and all four contacts sit in
         this first block, so the scan's essentials never depend on the fold;
         none of it is ever eligible for corruption. The portrait rides the
         right column, so it never costs the scan a pixel of vertical space. -->
    <div class="hero">
      <h1 class="headline hero-name">
        <span class="block">Rodrigo Flores</span>
        <span class="block">Bertolotti</span>
      </h1>

      <!-- Ink drawing as a single-color mask: it takes its color from the ink
           token, so it is epoxy ink on datasheet paper in light mode and
           silkscreen on the board in dark. One asset, both materials. -->
      <div
        class="hero-portrait"
        style={`--portrait: url('${portraitMask.src}')`}
        role="img"
        aria-label="Ink portrait of Rodrigo Flores Bertolotti"
      >
      </div>

      <div class="hero-spec">
        <p class="max-w-[75ch] font-mono text-[0.82rem] leading-relaxed text-ink">
          {site.education.line}
        </p>
        <p class="mt-1 max-w-[75ch] font-sans text-sm text-muted">{site.education.coursework}</p>

        <p class="standfirst mt-4 max-w-[52ch]">{site.focus}</p>

        {/* The four contacts, in scan reach regardless of viewport height.
            The full labeled pinout (with CRCs) remains the Contact section. */}
        <p class="mt-4 flex flex-wrap gap-x-4 gap-y-1 font-mono text-xs" aria-label="Contact">
          {site.contacts.map((c) => (
            <a href={c.href} class="v-link text-muted hover:text-ink">{c.value}</a>
          ))}
        </p>

        <EccWord class="mt-5" />
      </div>
    </div>

    <section class="mt-8" aria-labelledby="selected-work" data-sec>
      <h2 id="selected-work" class="sec-label">Selected work</h2>

      <ul class="mt-3 list-none p-0 m-0" role="list">
        <li class="border-t border-line">
          <a href="/experience/" class="row group">
            <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-0.5">
              <h3 class="row-title">
                <span class="row-link">{mibanco.data.role}</span>
                <span class="font-normal text-muted"> — {mibanco.data.organization} ({mibanco.data.parent})</span>
              </h3>
              <span class="font-mono text-xs text-muted">Summer 2026</span>
            </div>
            <p class="mt-1 max-w-[68ch] text-base text-muted">
              Parallelized speech-to-text and LLM-interpretation pipeline for production workflows
              at Peru's largest microfinance bank.
            </p>
            <p class="mt-1.5 flex flex-wrap gap-x-4 gap-y-1 font-mono text-xs text-muted">
              <span>Lima, Peru · 12°03′S</span>
              {mibanco.data.stack.map((t) => <span>{t}</span>)}
            </p>
          </a>
        </li>

        <li class="border-t border-line">
          <a href="/research/" class="row group">
            <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-0.5">
              <h3 class="row-title">
                <span class="row-link">LLM fault-resilience research</span>
                <span class="font-normal text-muted"> — TRUE AI Lab, Oregon State University</span>
              </h3>
              <span class="font-mono text-xs text-muted">2025–present</span>
            </div>
            <p class="mt-1 max-w-[68ch] text-base text-muted">
              Contributed data and benchmarks to defenses against LLM bit-flip attacks;
              co-author on a cross-scale resilience paper.
            </p>
            <p class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1.5">
              <StatusStamp label={crossScale.data.statusLabel} />
              <StatusStamp label={bitflip.data.statusLabel} />
              <span class="flex flex-wrap gap-x-4 font-mono text-xs text-muted">
                <span>PyTorch</span><span>Hugging Face</span><span>Slurm</span>
              </span>
            </p>
          </a>
        </li>

        <li class="border-t border-b border-line">
          <a href="/projects/" class="row group">
            <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-0.5">
              <h3 class="row-title">
                <span class="row-link">{scout.data.title}</span>
                <span class="font-normal text-muted"> — own product, sole developer</span>
              </h3>
              <span class="font-mono text-xs text-muted">2026–present</span>
            </div>
            <p class="mt-1 max-w-[68ch] text-base text-muted">{scout.data.tagline}</p>
            <p class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1">
              <Led status="active" />
              <span class="flex flex-wrap gap-x-4 font-mono text-xs text-muted">
                <span>TypeScript</span><span>Next.js</span><span>PostgreSQL</span>
              </span>
            </p>
          </a>
        </li>
      </ul>
    </section>

    <section class="mt-8" aria-labelledby="contact" data-sec>
      <h2 id="contact" class="sec-label">Contact</h2>
      <div class="mt-3 border-t border-line pt-4">
        <PinContacts />
      </div>
    </section>
  </SiteShell>
</Base>

<style>
  /* Hero grid. Mobile: the portrait sits beside the nameplate only, so the
     spec line and focus line keep the full measure. From 64rem it spans the
     whole block and grows into the right column. */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: 1.25rem;
    align-items: start;
  }
  .hero-name {
    grid-column: 1;
    grid-row: 1;
  }
  .hero-spec {
    grid-column: 1 / -1;
    grid-row: 2;
    margin-top: 1rem;
  }
  .hero-portrait {
    grid-column: 2;
    grid-row: 1;
    width: clamp(5rem, 26vw, 7.5rem);
    aspect-ratio: 800 / 928;
    background-color: var(--c-ink);
    -webkit-mask-image: var(--portrait);
    mask-image: var(--portrait);
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-size: contain;
    mask-size: contain;
    -webkit-mask-position: center;
    mask-position: center;
  }
  /* Silkscreen on a dark board blooms; hold it just under full ink. */
  :global(.dark) .hero-portrait {
    opacity: 0.94;
  }

  @media (min-width: 40rem) {
    .hero {
      column-gap: 2rem;
    }
    .hero-portrait {
      width: 9rem;
    }
  }

  @media (min-width: 64rem) {
    .hero {
      column-gap: 2.5rem;
    }
    .hero-spec {
      grid-column: 1;
    }
    .hero-portrait {
      /* The rows are implicit, so `-1` would collapse to row 1 — span them. */
      grid-row: 1 / span 2;
      width: clamp(13rem, 21vw, 16.5rem);
      align-self: center;
    }
  }

  /* Background graphics do not print — drop it rather than leave a hole. */
  @media print {
    .hero-portrait {
      display: none;
    }
  }

  /* The nameplate: Archivo expanded — an industrial stencil, never uppercase. */
  .headline {
    font-family: var(--font-display);
    font-variation-settings: 'wdth' 120;
    font-size: clamp(2.5rem, 6.5vw, 4.25rem);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.015em;
    /* Tight top margin: the 30-second scan must clear common laptop folds. */
    margin-top: 1.25rem;
  }

  /* Phones get one column and one left axis: portrait, then nameplate, then
     spec — all flush to the same edge and all on the full measure. Sharing a
     line with the portrait would force the nameplate onto a narrower measure
     than everything under it, which reads as misaligned. */
  @media (max-width: 39.99rem) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
    }
    .hero-portrait {
      grid-column: 1;
      grid-row: 1;
      width: clamp(7rem, 33vw, 10rem);
      margin-top: 1.25rem;
    }
    .headline.hero-name {
      grid-row: 2;
      margin-top: 1.125rem;
      /* Sized so "Rodrigo Flores" holds one line down to 320px — the
         nameplate keeps its two-line structure instead of breaking to three. */
      font-size: clamp(2rem, 10vw, 2.5rem);
    }
    .hero-spec {
      grid-row: 3;
      margin-top: 1.5rem;
    }
  }

  .standfirst {
    font-size: clamp(1.125rem, 1.05rem + 0.7vw, 1.28rem);
    line-height: 1.5;
  }

  .sec-label {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--c-muted);
  }

  .row {
    display: block;
    padding-block: 0.7rem;
    text-decoration: none;
  }
  .row-title {
    font-size: 1.25rem;
    line-height: 1.35;
    font-weight: 600;
  }
  .row:hover .row-link,
  .row:focus-visible .row-link {
    background-image: linear-gradient(var(--c-gold), var(--c-gold));
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 100% 2px;
  }
</style>
