---
import Base from '../layouts/Base.astro';
import SiteShell from '../components/SiteShell.astro';
import BitSignature from '../components/BitSignature.astro';
import { site } from '../data/site';
import { getCollection } from 'astro:content';

const research = await getCollection('research');
const experience = await getCollection('experience');
const projects = await getCollection('projects');

function must<T>(value: T | undefined, id: string): T {
  if (!value) throw new Error(`Home page: required content entry "${id}" is missing`);
  return value;
}
const bitflip = must(research.find((r) => r.id === 'targeted-bitflip-defense'), 'research/targeted-bitflip-defense');
const crossScale = must(research.find((r) => r.id === 'cross-scale-resilience'), 'research/cross-scale-resilience');
const mibanco = must(experience.find((e) => e.id === 'mibanco'), 'experience/mibanco');
const scout = must(projects.find((p) => p.id === 'internship-scout'), 'projects/internship-scout');

// Experience first: lead with the production internship.
const entries = [
  {
    href: '/experience/',
    title: mibanco.data.role,
    where: `${mibanco.data.organization} (${mibanco.data.parent}), ${mibanco.data.location}`,
    when: 'Summer 2026',
    desc: "Parallelized speech-to-text and LLM-interpretation pipeline for production workflows at Peru's largest microfinance bank.",
    tags: ['Databricks', 'Python', 'SQL', 'Azure AI'],
    statuses: [],
  },
  {
    href: '/research/',
    title: 'LLM fault-resilience research',
    where: 'TRUE AI Lab, Oregon State University',
    when: '2025–2026',
    desc: 'Ran the initial investigation and early results on defenses against LLM bit-flip attacks; co-author on a cross-scale resilience paper.',
    tags: ['PyTorch', 'Hugging Face', 'Slurm'],
    statuses: [bitflip.data.statusLabel, crossScale.data.statusLabel],
  },
  {
    href: '/projects/',
    title: scout.data.title,
    where: 'own product',
    when: `${scout.data.start.getFullYear()}–present`,
    desc: scout.data.tagline,
    tags: ['TypeScript', 'Next.js', 'PostgreSQL'],
    statuses: [],
  },
];
---

<Base ogImage="/og/home.png">
  <SiteShell>
    <BitSignature class="mb-5" />

    <h1 class="headline">
      <span class="block">Rodrigo Flores</span>
      <span class="surname block text-accent">Bertolotti</span>
    </h1>

    <p class="standfirst mt-6 max-w-[56ch]">{site.focus}</p>

    <p class="mt-5 max-w-[75ch]">{site.education.line}</p>
    <p class="mt-1 max-w-[75ch] font-sans text-sm text-muted">{site.education.coursework}</p>

    <!-- Labeled contact grid (borrowed from the technical direction) -->
    <ul class="mt-7 grid grid-cols-1 gap-x-6 gap-y-3 sm:grid-cols-2 xl:grid-cols-4" aria-label="Contact">
      {
        site.contacts.map((c) => (
          <li class="min-w-0">
            <span class="block font-sans text-xs text-muted">{c.label}</span>
            <a href={c.href} class="contact-link font-mono text-[0.82rem] break-words">
              {c.value}
            </a>
          </li>
        ))
      }
    </ul>

    <section class="mt-10" aria-labelledby="selected-work">
      <h2 id="selected-work" class="font-sans text-sm font-medium text-muted">Selected work</h2>
      <ul class="mt-3 border-t border-line list-none p-0">
        {
          entries.map((e) => (
            <li class="entry border-b border-line">
              <a href={e.href} class="block py-3.5 no-underline">
                <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-0.5">
                  <h3 class="text-[1.25rem] leading-snug font-semibold">
                    <span class="entry-title">{e.title}</span>
                    <span class="font-normal text-muted"> — {e.where}</span>
                  </h3>
                  <span class="font-mono text-xs text-muted">{e.when}</span>
                </div>
                <p class="mt-1 max-w-[68ch] text-base text-muted">{e.desc}</p>
                <p class="mt-1.5 flex flex-wrap gap-x-4 gap-y-1 font-mono text-xs text-muted">
                  {e.statuses.map((s) => (
                    <span class="text-accent">{s}</span>
                  ))}
                  {e.tags.map((t) => (
                    <span>{t}</span>
                  ))}
                </p>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </SiteShell>
</Base>

<style>
  /* Oversized STIX thesis: committed scale contrast, tight but legal. */
  .headline {
    font-size: clamp(2.5rem, 7vw, 5rem);
    font-weight: 600;
    line-height: 1.04;
    letter-spacing: -0.025em;
  }

  .standfirst {
    font-size: clamp(1.125rem, 1.05rem + 0.8vw, 1.3rem);
    line-height: 1.5;
  }

  .contact-link {
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.32em;
    text-decoration-color: var(--c-line);
    transition: text-decoration-color 120ms ease;
  }
  .contact-link:hover {
    text-decoration-color: var(--c-accent);
  }

  .entry a:hover .entry-title,
  .entry a:focus-visible .entry-title {
    text-decoration-line: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.22em;
  }
</style>
