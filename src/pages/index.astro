---
import Base from '../layouts/Base.astro';
import BitSignature from '../components/BitSignature.astro';
import { site } from '../data/site';
---

<Base>
  <section class="mx-auto max-w-4xl px-5 py-16">
    <BitSignature />
    <h1 class="mt-6 text-4xl font-semibold">{site.name}</h1>
    <p class="mt-3 max-w-[68ch] text-muted">{site.focus}</p>
    <p class="mt-2 max-w-[68ch]">{site.education.line}</p>
  </section>
</Base>
