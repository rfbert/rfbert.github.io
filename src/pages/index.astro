---
import Base from '../layouts/Base.astro';
import SiteShell from '../components/SiteShell.astro';
import EccWord from '../components/EccWord.astro';
import PinContacts from '../components/PinContacts.astro';
import StatusStamp from '../components/StatusStamp.astro';
import Led from '../components/Led.astro';
import { site } from '../data/site';
import { getCollection } from 'astro:content';
import portraitMask from '../assets/portrait-mask.png';

const research = await getCollection('research');
const experience = await getCollection('experience');
const projects = await getCollection('projects');

function must<T>(value: T | undefined, id: string): T {
  if (!value) throw new Error(`Home page: required content entry "${id}" is missing`);
  return value;
}
const bitflip = must(research.find((r) => r.id === 'targeted-bitflip-defense'), 'research/targeted-bitflip-defense');
const crossScale = must(research.find((r) => r.id === 'cross-scale-resilience'), 'research/cross-scale-resilience');
const mibanco = must(experience.find((e) => e.id === 'mibanco'), 'experience/mibanco');
const scout = must(projects.find((p) => p.id === 'internship-scout'), 'projects/internship-scout');

// The two promoted hero actions and the two quiet contacts, pulled from the
// single contacts source so nothing drifts.
const byLabel = (label: string) => must(site.contacts.find((c) => c.label === label), `contact/${label}`);
const resume = byLabel('Resume');
const email = byLabel('Email');
const github = byLabel('GitHub');
const linkedin = byLabel('LinkedIn');

// At-a-glance chips: the mono voice carries only the genuine datum (a count,
// scale, dataset, or tool name); the describing word rides alongside in sans,
// so mono never dresses up prose. Every value is defensible from the content.
const researchMetrics = [
  { v: '7', label: 'defenses' },
  { v: '2', label: 'attack classes' },
  { v: '1B–8B', label: 'models' },
  { v: 'GSM8K' },
];
const scoutMetrics = [
  { v: '5', label: 'stage pipeline' },
  { v: '2', label: 'deployments' },
  { v: 'Vitest + Playwright', label: 'in CI' },
];
---

<Base
  ogImage="/og/home.png"
  ogAlt="Portfolio card for Rodrigo Flores Bertolotti with a caught-bit mark in the SEC-DED site style."
>
  <SiteShell>
    <!-- Part header: name, positioning line, the two promoted actions, all four
         contacts, and the degree metadata sit in this first block, so the scan's
         essentials never depend on the fold; none of it is ever eligible for
         corruption. The portrait rides the right column, so it never costs the
         scan a pixel of vertical space. -->
    <div class="hero">
      <h1 class="headline hero-name">
        <span class="block">Rodrigo Flores</span>
        <span class="block">Bertolotti</span>
      </h1>

      <!-- Ink drawing as a single-color mask: it takes its color from the ink
           token, so it is epoxy ink on datasheet paper in light mode and
           silkscreen on the board in dark. One asset, both materials. -->
      <div
        class="hero-portrait"
        style={`--portrait: url('${portraitMask.src}')`}
        role="img"
        aria-label="Ink portrait of Rodrigo Flores Bertolotti"
      >
      </div>

      <div class="hero-spec">
        {/* The recruiter-first lead: what I build, before any coursework. */}
        <p class="standfirst max-w-[46ch]">{site.positioning}</p>
        <p class="mt-3 max-w-[58ch] text-base text-muted">{site.focus}</p>

        {/* Two promoted actions in the datasheet's control language: a bordered
            command with a contact pad that fills gold on hover/focus. GitHub and
            LinkedIn stay a quiet keystroke away, so all four contacts remain in
            scan reach; the full labeled pinout (with CRCs) is the Contact section. */}
        <div class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-2.5">
          <a href={resume.href} class="cta">
            <span class="cta-pad" aria-hidden="true"></span>
            <span>Resume</span>
            <span class="cta-meta">PDF</span>
            <span class="cta-arrow" aria-hidden="true">↗</span>
          </a>
          <a href={email.href} class="cta">
            <span class="cta-pad" aria-hidden="true"></span>
            <span>Email</span>
            <span class="cta-arrow" aria-hidden="true">↗</span>
          </a>
          <span class="flex flex-wrap items-center gap-x-2 gap-y-1 font-mono text-xs" role="group" aria-label="More contacts">
            <a href={github.href} class="v-link text-muted hover:text-ink">{github.value}</a>
            <span class="text-muted" aria-hidden="true">·</span>
            <a href={linkedin.href} class="v-link text-muted hover:text-ink">{linkedin.value}</a>
          </span>
        </div>

        {/* Degree, GPA, coursework — secondary metadata now, muted below the lead. */}
        <div class="mt-5 max-w-[75ch]">
          <p class="font-mono text-[0.8rem] leading-relaxed text-muted">{site.education.line}</p>
          <p class="mt-0.5 font-sans text-sm text-muted">{site.education.coursework}</p>
        </div>

        {/* The explainer rides the strip's own control row, beside the buttons
            it describes. One sentence, native <details> — no JS needed. */}
        <EccWord class="mt-5">
          <details class="ecc-note">
            <summary aria-label="What this strip means"><span aria-hidden="true">ⓘ</span></summary>
            <p class="ecc-note-body">
              One byte plus a single check bit. Flip one bit and the parity disagrees, so the
              fault is caught and corrected. Flip two and the parity agrees again — the word is
              wrong and still looks fine. Catching that case is what my research is about.
            </p>
          </details>
        </EccWord>
      </div>
    </div>

    <section class="mt-8" aria-labelledby="selected-work">
      <h2 id="selected-work" class="sec-label">Selected work</h2>

      <ul class="mt-3 list-none p-0 m-0" role="list">
        <li class="border-t border-line">
          <a href="/experience/" class="row group">
            <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-0.5">
              <h3 class="row-title">
                <span class="row-link">{mibanco.data.role}</span>
                <span class="font-normal text-muted"> — {mibanco.data.organization} ({mibanco.data.parent})</span>
              </h3>
              <span class="ml-auto font-mono text-xs text-muted">Summer 2026</span>
            </div>
            <p class="mt-1 max-w-[68ch] text-base text-muted">
              Parallelized speech-to-text and LLM-interpretation pipeline for production workflows
              at Peru’s largest microfinance bank.
            </p>
            <p class="mt-1.5 flex flex-wrap gap-x-4 gap-y-1 font-mono text-xs text-muted">
              <span>Lima, Peru · 12°03′S</span>
              {mibanco.data.stack.map((t) => <span>{t}</span>)}
            </p>
          </a>
        </li>

        <li class="border-t border-line">
          <a href="/research/" class="row group">
            <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-0.5">
              <h3 class="row-title">
                <span class="row-link">LLM fault-resilience research</span>
                <span class="font-normal text-muted"> — TRUE AI Lab, Oregon State University</span>
              </h3>
              <span class="ml-auto font-mono text-xs text-muted">2025–present</span>
            </div>
            <p class="mt-1 max-w-[68ch] text-base text-muted">
              Contributed data and benchmarks to defenses against LLM bit-flip attacks;
              co-author on a cross-scale resilience paper.
            </p>
            <p class="metrics">
              {researchMetrics.map((m) => (
                <span class="metric">
                  <span class="metric-val">{m.v}</span>
                  {m.label && <span class="metric-label">{m.label}</span>}
                </span>
              ))}
            </p>
            <p class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1.5">
              <StatusStamp label={crossScale.data.statusLabel} />
              <StatusStamp label={bitflip.data.statusLabel} />
              <span class="flex flex-wrap gap-x-4 font-mono text-xs text-muted">
                <span>PyTorch</span><span>Hugging Face</span><span>Slurm</span>
              </span>
            </p>
          </a>
        </li>

        <li class="border-t border-b border-line">
          <a href="/projects/" class="row group">
            <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-0.5">
              <h3 class="row-title">
                <span class="row-link">{scout.data.title}</span>
                <span class="font-normal text-muted"> — own product, directed end to end</span>
              </h3>
              <span class="ml-auto font-mono text-xs text-muted">2026–present</span>
            </div>
            <p class="mt-1 max-w-[68ch] text-base text-muted">{scout.data.tagline}</p>
            <p class="metrics">
              {scoutMetrics.map((m) => (
                <span class="metric">
                  <span class="metric-val">{m.v}</span>
                  {m.label && <span class="metric-label">{m.label}</span>}
                </span>
              ))}
            </p>
            <p class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1">
              <Led status="active" />
              <span class="flex flex-wrap gap-x-4 font-mono text-xs text-muted">
                <span>TypeScript</span><span>Next.js</span><span>PostgreSQL</span>
              </span>
            </p>
          </a>
        </li>
      </ul>
    </section>

    <section class="mt-8" aria-labelledby="contact">
      <h2 id="contact" class="sec-label">Contact</h2>
      <div class="mt-3 border-t border-line pt-4">
        <PinContacts />
      </div>
    </section>
  </SiteShell>
</Base>

<style>
  /* Hero grid. Mobile: the portrait sits beside the nameplate only, so the
     spec line and focus line keep the full measure. From 64rem it spans the
     whole block and grows into the right column. */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: 1.25rem;
    align-items: start;
  }
  .hero-name {
    grid-column: 1;
    grid-row: 1;
  }
  .hero-spec {
    grid-column: 1 / -1;
    grid-row: 2;
    margin-top: 1rem;
  }
  .hero-portrait {
    grid-column: 2;
    grid-row: 1;
    width: clamp(5rem, 26vw, 7.5rem);
    aspect-ratio: 800 / 928;
    background-color: var(--c-ink);
    -webkit-mask-image: var(--portrait);
    mask-image: var(--portrait);
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-size: contain;
    mask-size: contain;
    -webkit-mask-position: center;
    mask-position: center;
  }
  /* Silkscreen on a dark board blooms; hold it just under full ink. */
  :global(.dark) .hero-portrait {
    opacity: 0.94;
  }

  @media (min-width: 40rem) {
    .hero {
      column-gap: 2rem;
    }
    .hero-portrait {
      width: 9rem;
    }
  }

  @media (min-width: 64rem) {
    .hero {
      column-gap: 2.5rem;
    }
    .hero-spec {
      grid-column: 1;
    }
    .hero-portrait {
      /* The rows are implicit, so `-1` would collapse to row 1 — span them. */
      grid-row: 1 / span 2;
      width: clamp(13rem, 21vw, 16.5rem);
      align-self: center;
    }
  }

  /* Background graphics do not print — drop it rather than leave a hole. */
  @media print {
    .hero-portrait {
      display: none;
    }
  }

  /* The nameplate: Archivo expanded — an industrial stencil, never uppercase. */
  .headline {
    font-family: var(--font-display);
    font-variation-settings: 'wdth' 120;
    font-size: clamp(2.5rem, 6.5vw, 4.25rem);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.015em;
    /* Tight top margin: the 30-second scan must clear common laptop folds. */
    margin-top: 1.25rem;
  }

  /* Phones get one column and one left axis: portrait, then nameplate, then
     spec — all flush to the same edge and all on the full measure. Sharing a
     line with the portrait would force the nameplate onto a narrower measure
     than everything under it, which reads as misaligned. */
  @media (max-width: 39.99rem) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
    }
    .hero-portrait {
      grid-column: 1;
      grid-row: 1;
      width: clamp(7rem, 33vw, 10rem);
      margin-top: 1.25rem;
    }
    .headline.hero-name {
      grid-row: 2;
      margin-top: 1.125rem;
      /* Sized so "Rodrigo Flores" holds one line down to 320px — the
         nameplate keeps its two-line structure instead of breaking to three. */
      font-size: clamp(1.85rem, 9.4vw, 2.5rem);
    }
    .hero-spec {
      grid-row: 3;
      margin-top: 1.5rem;
    }
  }

  .standfirst {
    font-size: clamp(1.125rem, 1.05rem + 0.7vw, 1.28rem);
    line-height: 1.5;
  }

  /* Promoted actions in the datasheet's own control grammar: a bordered command
     carrying a gold contact pad that makes contact (fills) on hover/focus. The
     44px min-height doubles as a comfortable touch target. */
  .cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.4rem 0.85rem;
    border: 1.5px solid var(--c-line);
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--c-ink);
    text-decoration: none;
    transition: border-color 160ms ease-out;
  }
  .cta:hover,
  .cta:focus-visible {
    border-color: var(--c-gold);
  }
  .cta-pad {
    display: block;
    width: 0.6rem;
    height: 0.6rem;
    border: 1.5px solid var(--c-gold);
    transition: background 160ms ease-out;
  }
  .cta:hover .cta-pad,
  .cta:focus-visible .cta-pad {
    background: var(--c-gold);
  }
  .cta-meta {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 400;
    color: var(--c-muted);
  }
  .cta-arrow {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--c-gold-text);
  }

  /* Outcome chips: the datum stays in the mono voice (true data — counts, scales,
     datasets, tools), the describing word rides alongside in sans. Mono never
     dresses up prose, and the number leans on the site's single 600 emphasis. */
  .metrics {
    margin-top: 0.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    font-size: 0.72rem;
  }
  .metric {
    display: inline-flex;
    align-items: baseline;
    gap: 0.3rem;
  }
  .metric-val {
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--c-ink);
  }
  .metric-label {
    font-family: var(--font-sans);
    color: var(--c-muted);
  }

  /* The ECC explainer: a subtle info affordance that discloses one sentence.
     The body is taken out of flow — as a flex item, a <details> otherwise
     contributes its closed body's full width and pushes the marker to its own
     line. Out of flow, the marker stays beside the strip and the panel opens
     over the content below without shifting anything. */
  .ecc-note {
    position: relative;
  }
  .ecc-note > summary {
    list-style: none;
    cursor: pointer;
    color: var(--c-muted);
    /* A real tap target (≥24px, WCAG 2.5.8) — matches the site's other controls. */
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.5rem;
    min-height: 1.5rem;
    font-size: 0.85rem;
  }
  .ecc-note > summary::-webkit-details-marker {
    display: none;
  }
  .ecc-note > summary:hover,
  .ecc-note > summary:focus-visible {
    color: var(--c-gold-text);
  }
  .ecc-note-body {
    position: absolute;
    top: 100%;
    left: 0;
    z-index: 10;
    margin: 0.4rem 0 0;
    width: max-content;
    max-width: min(48ch, calc(100vw - 3rem));
    border: 1px solid var(--c-line);
    background: var(--c-surface);
    padding: 0.55rem 0.75rem;
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--c-muted);
  }

  .sec-label {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--c-muted);
  }

  .row {
    display: block;
    padding-block: 0.7rem;
    text-decoration: none;
  }
  .row-title {
    font-size: 1.25rem;
    line-height: 1.35;
    font-weight: 600;
  }
  .row:hover .row-link,
  .row:focus-visible .row-link {
    background-image: linear-gradient(var(--c-gold), var(--c-gold));
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 100% 2px;
  }
</style>
