---
import Base from '../../layouts/Base.astro';
import SiteShell from '../../components/SiteShell.astro';
import PageIntro from '../../components/PageIntro.astro';
import Prose from '../../components/Prose.astro';
import Led from '../../components/Led.astro';
import { getCollection, render } from 'astro:content';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order
);
const rendered = await Promise.all(
  projects.map(async (entry) => ({ entry, Content: (await render(entry)).Content }))
);

// Content dates are UTC midnights; format in UTC or the build timezone
// renders every 1st-of-month one month early.
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' });

// Internship Scout's real morning pipeline, drawn as a routed trace.
const pipeline = ['scrape', 'dedupe', 'rules engine', 'LLM scoring', 'kanban'];
---

<Base
  title="Projects — Rodrigo Flores Bertolotti"
  description="Projects: Internship Scout, a full-stack internship-discovery agent; and an AI productivity automation system."
  ogImage="/og/projects.png"
>
  <SiteShell>
    <PageIntro title="Projects" lede="Things I build and run on my own." />

    <ul class="list-none p-0 m-0 space-y-0">
      {
        rendered.map(({ entry, Content }) => (
          <li class="border-t border-line py-7" data-sec>
            <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-0.5">
              <h2 class="text-[1.35rem] leading-snug font-semibold">{entry.data.title}</h2>
              <span class="font-mono text-xs text-muted">
                {fmt(entry.data.start)}{entry.data.end ? `–${fmt(entry.data.end)}` : '–present'}
              </span>
            </div>
            <p class="mt-1 flex flex-wrap items-center gap-x-4 gap-y-1 font-sans text-sm text-muted">
              <Led status={entry.data.status} />
              <span>{entry.data.role}</span>
            </p>
            <p class="mt-1.5 flex flex-wrap gap-x-4 gap-y-1 font-mono text-xs text-muted">
              {entry.data.stack.map((t) => (
                <span>{t}</span>
              ))}
            </p>
            {entry.data.repoNote && (
              <p class="mt-1.5 font-mono text-xs text-gold-text">{entry.data.repoNote}</p>
            )}

            {entry.data.featured && (
              <div class="js-trace mt-5 max-w-2xl border border-line px-4 py-4 sm:px-5" role="group" aria-label="Morning pipeline">
                <p class="m-0 font-sans text-xs text-muted">
                  every morning, via GitHub Actions
                </p>
                <ol class="mt-3 flex flex-wrap items-center gap-y-3 list-none p-0 m-0">
                  {pipeline.map((stage, i) => (
                    <li class="flex items-center">
                      {i > 0 && <span class="trace-wire" aria-hidden="true" />}
                      <span class="flex items-center gap-1.5">
                        <span class="trace-pad" aria-hidden="true" />
                        <span class="font-mono text-[0.72rem] text-ink">{stage}</span>
                      </span>
                    </li>
                  ))}
                </ol>
              </div>
            )}

            <div class="mt-4">
              <Prose>
                <Content />
              </Prose>
            </div>
          </li>
        ))
      }
    </ul>
  </SiteShell>
</Base>

<style>
  .trace-pad {
    display: block;
    width: 0.6rem;
    height: 0.6rem;
    border: 1.5px solid var(--c-gold);
    background: var(--c-gold);
    transition: background 200ms steps(2);
  }
  .trace-wire {
    display: block;
    width: 1.6rem;
    height: 1.5px;
    margin-inline: 0.5rem;
    background: var(--c-line);
  }
  /* JS stages the power-up; without JS (or with reduced motion) all pads sit lit. */
  .js-trace.trace-armed .trace-pad {
    background: transparent;
  }
</style>

<script>
  // Each pipeline stage's pad steps on once as the trace scrolls into view.
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('.js-trace').forEach((trace) => {
    if (reduced) return;
    trace.classList.add('trace-armed');
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        trace.querySelectorAll<HTMLElement>('.trace-pad').forEach((pad, i) => {
          setTimeout(() => (pad.style.background = 'var(--c-gold)'), 120 * i);
        });
        setTimeout(() => trace.classList.remove('trace-armed'), 120 * 6);
      },
      { threshold: 0.4 }
    );
    io.observe(trace);
  });
</script>
