---
import Base from '../../layouts/Base.astro';
import SiteShell from '../../components/SiteShell.astro';
import PageIntro from '../../components/PageIntro.astro';
import Prose from '../../components/Prose.astro';
import Led from '../../components/Led.astro';
import PipelineTrace from '../../components/PipelineTrace.astro';
import SpecStrip from '../../components/SpecStrip.astro';
import { getCollection, render } from 'astro:content';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order
);
const rendered = await Promise.all(
  projects.map(async (entry) => ({ entry, Content: (await render(entry)).Content }))
);

// Content dates are UTC midnights; format in UTC or the build timezone
// renders every 1st-of-month one month early.
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' });

// Internship Scout's verifiable engineering facts — all defensible from the
// project write-up, surfaced as artifact evidence beside the architecture.
const scoutEvidence = [
  'Idempotent pipeline runs',
  'Vitest unit + integration and Playwright end-to-end tests gate CI',
  'Deterministic rules run before any model call',
  'LLM scores must cite verbatim posting text',
  'A person accepts every result before it counts',
];
---

<Base
  title="Projects — Rodrigo Flores Bertolotti"
  description="Projects: Internship Scout, a full-stack internship-discovery agent; and an AI productivity automation system."
  ogImage="/og/projects.png"
  ogAlt="Projects card for Rodrigo Flores Bertolotti with a caught-bit mark in the SEC-DED site style."
>
  <SiteShell>
    <PageIntro title="Projects" lede="Things I specify, direct, and run on my own." />

    <ul class="list-none p-0 m-0 space-y-0" role="list">
      {
        rendered.map(({ entry, Content }) => (
          <li class="border-t border-line py-7">
            <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-0.5">
              <h2 class="text-[1.35rem] leading-snug font-semibold">{entry.data.title}</h2>
              <span class="ml-auto font-mono text-xs text-muted">
                {!entry.data.end
                  ? `${fmt(entry.data.start)}–present`
                  : fmt(entry.data.end) === fmt(entry.data.start)
                    ? fmt(entry.data.start)
                    : `${fmt(entry.data.start)}–${fmt(entry.data.end)}`}
              </span>
            </div>
            <p class="mt-1 flex flex-wrap items-center gap-x-4 gap-y-1 font-sans text-sm text-muted">
              <Led status={entry.data.status} />
              <span>{entry.data.role}</span>
            </p>
            {entry.data.summary ? (
              <SpecStrip
                class="mt-4 max-w-[62ch]"
                problem={entry.data.summary.problem}
                built={entry.data.summary.built}
                result={entry.data.summary.result}
                stack={entry.data.stack}
              />
            ) : (
              <p class="mt-1.5 flex flex-wrap gap-x-4 gap-y-1 font-mono text-xs text-muted">
                {entry.data.stack.map((t) => (
                  <span>{t}</span>
                ))}
              </p>
            )}
            {entry.data.repoNote && (
              <p class="mt-2 font-sans text-sm text-gold-text">{entry.data.repoNote}</p>
            )}

            {entry.data.featured && (
              <div class="mt-5">
                {/* Architecture, not decoration: the real data flow — multi-source
                    collection, the dedupe/rules/LLM pipeline, Postgres, and the ranked
                    kanban board — drawn in the site's schematic grammar. */}
                <figure class="schematic max-w-lg text-muted">
                  <svg viewBox="0 0 360 116" class="w-full" role="img" aria-labelledby="scout-arch-title">
                    <title id="scout-arch-title">
                      Architecture: the pipeline collects postings from multiple sources, runs them
                      through dedupe, an eligibility rules engine, and LLM scoring that cites verbatim
                      posting text, writes to Postgres, and surfaces ranked results on a kanban board.
                    </title>
                    <g font-family="IBM Plex Mono, monospace" font-size="10.5" fill="currentColor">
                      <text x="180" y="18" text-anchor="middle">deterministic gates before any model call</text>
                    </g>
                    <g fill="none" stroke="currentColor" stroke-width="1.5">
                      <rect x="6" y="46" width="58" height="40" />
                      <rect x="90" y="46" width="98" height="40" />
                      <ellipse cx="228" cy="50" rx="20" ry="6" />
                      <path d="M208 50 V82 A20 6 0 0 0 248 82 V50" />
                      <rect x="288" y="46" width="64" height="40" />
                      <path d="M64 66 H82" />
                      <path d="M188 66 H200" />
                      <path d="M248 66 H280" />
                    </g>
                    <g fill="currentColor" stroke="none">
                      <path d="M82 62 l8 4 -8 4 z" />
                      <path d="M200 62 l8 4 -8 4 z" />
                      <path d="M280 62 l8 4 -8 4 z" />
                    </g>
                    {/* Ranked board: the top card is verified-gold, per site grammar. */}
                    <rect x="296" y="53" width="48" height="6" fill="var(--c-gold)" stroke="none" />
                    <g fill="none" stroke="currentColor" stroke-width="1">
                      <rect x="296" y="64" width="48" height="5" />
                      <rect x="296" y="74" width="48" height="5" />
                    </g>
                    <g font-family="IBM Plex Mono, monospace" font-size="10.5" fill="currentColor">
                      <text x="35" y="70" text-anchor="middle">sources</text>
                      <text x="139" y="64" text-anchor="middle">pipeline</text>
                      <text x="139" y="78" text-anchor="middle" font-size="9">rules · LLM score</text>
                      <text x="228" y="100" text-anchor="middle">Postgres</text>
                      <text x="320" y="100" text-anchor="middle">kanban</text>
                    </g>
                  </svg>
                </figure>

                {/* Artifact evidence: verifiable facts, stronger than a promise of a
                    future repo. Plain-English facts in sans; the ✓ is the only gold. */}
                <div class="mt-4 max-w-md border border-line px-4 py-3">
                  <p class="m-0 font-sans text-xs text-muted">Evidence</p>
                  <ul class="mt-2 list-none p-0 m-0 space-y-1 font-sans text-sm text-muted" role="list">
                    {scoutEvidence.map((item) => (
                      <li class="flex gap-2">
                        <span class="text-gold-text" aria-hidden="true">✓</span>
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            )}

            {entry.id === 'ai-productivity' && (
              <PipelineTrace
                caption="one automation layer across five platforms"
                stages={['Calendar', 'Gmail', 'Telegram', 'Notion', 'Sheets']}
                ariaLabel="Connected platforms"
              />
            )}

            <div class="mt-4">
              <Prose>
                <Content />
              </Prose>
            </div>
          </li>
        ))
      }
    </ul>
  </SiteShell>
</Base>

