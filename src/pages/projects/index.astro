---
import Base from '../../layouts/Base.astro';
import SiteShell from '../../components/SiteShell.astro';
import PageIntro from '../../components/PageIntro.astro';
import Prose from '../../components/Prose.astro';
import Led from '../../components/Led.astro';
import PipelineTrace from '../../components/PipelineTrace.astro';
import { getCollection, render } from 'astro:content';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order
);
const rendered = await Promise.all(
  projects.map(async (entry) => ({ entry, Content: (await render(entry)).Content }))
);

// Content dates are UTC midnights; format in UTC or the build timezone
// renders every 1st-of-month one month early.
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' });

// Internship Scout's real morning pipeline, drawn as a routed trace.
const pipeline = ['scrape', 'dedupe', 'rules engine', 'LLM scoring', 'kanban'];
---

<Base
  title="Projects — Rodrigo Flores Bertolotti"
  description="Projects: Internship Scout, a full-stack internship-discovery agent; and an AI productivity automation system."
  ogImage="/og/projects.png"
>
  <SiteShell>
    <PageIntro title="Projects" lede="Things I build and run on my own." />

    <ul class="list-none p-0 m-0 space-y-0" role="list">
      {
        rendered.map(({ entry, Content }) => (
          <li class="border-t border-line py-7" data-sec>
            <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-0.5">
              <h2 class="text-[1.35rem] leading-snug font-semibold">{entry.data.title}</h2>
              <span class="font-mono text-xs text-muted">
                {!entry.data.end
                  ? `${fmt(entry.data.start)}–present`
                  : fmt(entry.data.end) === fmt(entry.data.start)
                    ? fmt(entry.data.start)
                    : `${fmt(entry.data.start)}–${fmt(entry.data.end)}`}
              </span>
            </div>
            <p class="mt-1 flex flex-wrap items-center gap-x-4 gap-y-1 font-sans text-sm text-muted">
              <Led status={entry.data.status} />
              <span>{entry.data.role}</span>
            </p>
            <p class="mt-1.5 flex flex-wrap gap-x-4 gap-y-1 font-mono text-xs text-muted">
              {entry.data.stack.map((t) => (
                <span>{t}</span>
              ))}
            </p>
            {entry.data.repoNote && (
              <p class="mt-1.5 font-mono text-xs text-gold-text">{entry.data.repoNote}</p>
            )}

            {entry.data.featured && (
              <PipelineTrace
                caption="every morning, via GitHub Actions"
                stages={pipeline}
                ariaLabel="Morning pipeline"
              />
            )}

            {entry.id === 'ai-productivity' && (
              <PipelineTrace
                caption="one automation layer across five platforms"
                stages={['calendar', 'gmail', 'telegram', 'notion', 'sheets']}
                ariaLabel="Connected platforms"
              />
            )}

            <div class="mt-4">
              <Prose>
                <Content />
              </Prose>
            </div>
          </li>
        ))
      }
    </ul>
  </SiteShell>
</Base>

