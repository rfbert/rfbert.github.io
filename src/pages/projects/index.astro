---
import Base from '../../layouts/Base.astro';
import SiteShell from '../../components/SiteShell.astro';
import PageIntro from '../../components/PageIntro.astro';
import Prose from '../../components/Prose.astro';
import { getCollection, render } from 'astro:content';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order
);
const rendered = await Promise.all(
  projects.map(async (entry) => ({ entry, Content: (await render(entry)).Content }))
);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
---

<Base
  title="Projects — Rodrigo Flores Bertolotti"
  description="Projects: Internship Scout, a full-stack internship-discovery agent; and an AI productivity automation system."
  ogImage="/og/projects.png"
>
  <SiteShell>
    <PageIntro
      title="Projects"
      lede="Things I design, build, launch, and iterate myself — the same end-to-end habit I bring to research and internships."
    />

    <ul class="list-none p-0 m-0 space-y-10">
      {
        rendered.map(({ entry, Content }) => (
          <li class="border-t border-line pt-6">
            <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-0.5">
              <h2 class="text-[1.35rem] leading-snug font-semibold">{entry.data.title}</h2>
              <span class="font-mono text-xs text-muted">
                {fmt(entry.data.start)}
                {entry.data.end ? `–${fmt(entry.data.end)}` : '–present'}
              </span>
            </div>
            <p class="mt-1 font-sans text-sm text-muted">{entry.data.role}</p>
            <p class="mt-1.5 flex flex-wrap gap-x-4 gap-y-1 font-mono text-xs text-muted">
              {entry.data.stack.map((t) => (
                <span>{t}</span>
              ))}
            </p>
            {entry.data.repoNote && (
              <p class="mt-1.5 font-mono text-xs text-accent">{entry.data.repoNote}</p>
            )}
            <div class="mt-3">
              <Prose>
                <Content />
              </Prose>
            </div>
          </li>
        ))
      }
    </ul>
  </SiteShell>
</Base>
