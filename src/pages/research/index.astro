---
import Base from '../../layouts/Base.astro';
import SiteShell from '../../components/SiteShell.astro';
import PageIntro from '../../components/PageIntro.astro';
import Prose from '../../components/Prose.astro';
import { getCollection, render } from 'astro:content';

const research = (await getCollection('research')).sort(
  (a, b) => a.data.order - b.data.order
);
const rendered = await Promise.all(
  research.map(async (entry) => ({ entry, Content: (await render(entry)).Content }))
);
---

<Base
  title="Research — Rodrigo Flores Bertolotti"
  description="LLM fault-resilience research at the TRUE (Trustworthy and Responsible) AI Lab, Oregon State University: bit-flip attacks on LLM inference and speculative-decoding-based defenses."
  ogImage="/og/research.png"
>
  <SiteShell>
    <PageIntro
      title="Research"
      lede="I study what hardware faults do to large language models — and how inference can defend itself. Undergraduate researcher at the TRUE (Trustworthy and Responsible) AI Lab, Oregon State University."
    />

    <ul class="list-none p-0 m-0 space-y-10">
      {
        rendered.map(({ entry, Content }) => (
          <li class="border-t border-line pt-6">
            <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-0.5">
              <h2 class="max-w-[56ch] text-[1.35rem] leading-snug font-semibold">{entry.data.title}</h2>
              <span class="font-mono text-xs text-muted">{entry.data.start.getFullYear()}–present</span>
            </div>
            <p class="mt-1.5 flex flex-wrap gap-x-4 gap-y-1 font-mono text-xs text-muted">
              <span class="text-accent">{entry.data.statusLabel}</span>
              <span>{entry.data.role}</span>
            </p>
            <p class="mt-1 font-sans text-sm text-muted">{entry.data.lab}</p>
            <div class="mt-3">
              <Prose>
                <Content />
              </Prose>
            </div>
          </li>
        ))
      }
    </ul>

    <p class="mt-10 max-w-[68ch] font-sans text-sm text-muted">
      Code for both directions is lab-owned and private until publication.
    </p>
  </SiteShell>
</Base>
