---
import Base from '../../layouts/Base.astro';
import SiteShell from '../../components/SiteShell.astro';
import PageIntro from '../../components/PageIntro.astro';
import Prose from '../../components/Prose.astro';
import StatusStamp from '../../components/StatusStamp.astro';
import BitExhibit from '../../components/BitExhibit.astro';
import { getCollection, render } from 'astro:content';

const research = (await getCollection('research')).sort(
  (a, b) => a.data.order - b.data.order
);
const rendered = await Promise.all(
  research.map(async (entry) => ({ entry, Content: (await render(entry)).Content }))
);
---

<Base
  title="Research — Rodrigo Flores Bertolotti"
  description="LLM fault-resilience research at the TRUE (Trustworthy and Responsible) AI Lab, Oregon State University: bit-flip attacks on LLM inference and speculative-decoding-based defenses."
  ogImage="/og/research.png"
>
  <SiteShell>
    <PageIntro
      title="Research"
      lede="I study what hardware faults do to large language models, and how inference can defend itself. Undergraduate researcher at the TRUE (Trustworthy and Responsible) AI Lab, Oregon State University."
    />

    <ul class="list-none p-0 m-0 space-y-0">
      {
        rendered.map(({ entry, Content }) => (
          <li class="border-t border-line py-7" data-sec>
            <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-0.5">
              <h2 class="max-w-[56ch] text-[1.35rem] leading-snug font-semibold">
                {entry.data.title}
              </h2>
              <span class="font-mono text-xs text-muted">{entry.data.start.getUTCFullYear()}</span>
            </div>
            <p class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1.5">
              <StatusStamp label={entry.data.statusLabel} />
              <span class="font-mono text-xs text-muted">{entry.data.role}</span>
            </p>
            <p class="mt-1 font-sans text-sm text-muted">{entry.data.lab}</p>

            {/* The manuscript register: abstracts speak in the paper's serif voice */}
            <div class="mt-3 font-serif">
              <Prose>
                <Content />
              </Prose>
            </div>

            {entry.id === 'cross-scale-resilience' && (
              <figure class="mt-5 max-w-md text-muted" aria-hidden="false">
                <svg viewBox="0 0 360 130" class="w-full" role="img" aria-labelledby="schematic-title">
                  <title id="schematic-title">
                    Schematic: a small draft model and the large target model cross-check each other;
                    the verification step doubles as a fault detector.
                  </title>
                  <g fill="none" stroke="currentColor" stroke-width="1.5">
                    <rect x="10" y="40" width="92" height="44" />
                    <rect x="258" y="40" width="92" height="44" />
                    <path d="M102 52 H 250" />
                    <path d="M250 48 l 8 4 -8 4 z" fill="currentColor" stroke="none" />
                    <path d="M258 74 H 110" />
                    <path d="M110 70 l -8 4 8 4 z" fill="currentColor" stroke="none" />
                  </g>
                  <rect x="173" y="56" width="14" height="14" fill="var(--c-gold)" />
                  <g
                    font-family="IBM Plex Mono, monospace"
                    font-size="10.5"
                    fill="currentColor"
                  >
                    <text x="56" y="58" text-anchor="middle">draft</text>
                    <text x="56" y="72" text-anchor="middle">1B</text>
                    <text x="304" y="58" text-anchor="middle">target</text>
                    <text x="304" y="72" text-anchor="middle">8B</text>
                    <text x="180" y="34" text-anchor="middle">proposes tokens</text>
                    <text x="180" y="96" text-anchor="middle">verifies each step</text>
                    <text x="180" y="118" text-anchor="middle" fill="var(--c-gold-text)">verify = detect + correct</text>
                  </g>
                </svg>
                <figcaption class="sr-only">
                  Draft and target models cross-check each other; verification doubles as fault
                  detection and correction.
                </figcaption>
              </figure>
            )}
          </li>
        ))
      }
    </ul>

    <p class="mt-4 max-w-[68ch] border-t border-line pt-4 font-sans text-sm text-muted">
      Code for both directions is lab-owned and private until publication.
    </p>

    <div class="mt-10">
      <BitExhibit />
    </div>
  </SiteShell>
</Base>
