---
import Base from '../../layouts/Base.astro';
import BitSignature from '../../components/BitSignature.astro';
import { site } from '../../data/site';
import { getCollection } from 'astro:content';

const research = await getCollection('research');
const experience = await getCollection('experience');
const projects = await getCollection('projects');

const bitflip = research.find((r) => r.id === 'targeted-bitflip-defense')!;
const crossScale = research.find((r) => r.id === 'cross-scale-resilience')!;
const lab = experience.find((e) => e.id === 'true-ai-lab')!;
const mibanco = experience.find((e) => e.id === 'mibanco')!;
const scout = projects.find((p) => p.id === 'internship-scout')!;

const entries = [
  {
    href: '/research/',
    title: crossScale.data.area,
    where: 'TRUE AI Lab, Oregon State University',
    when: `${lab.data.start.getFullYear()}–present`,
    desc: `Lead author on a targeted bit-flip defense (${bitflip.data.statusLabel.toLowerCase()}); co-author on cross-scale resilience (${crossScale.data.statusLabel.toLowerCase()}).`,
  },
  {
    href: '/experience/',
    title: mibanco.data.role,
    where: `${mibanco.data.organization} (${mibanco.data.parent}), ${mibanco.data.location}`,
    when: 'Summer 2026',
    desc: "Parallelized speech-to-text pipeline on Databricks and Azure AI, built for production workflows at Peru's largest microfinance bank.",
  },
  {
    href: '/projects/',
    title: scout.data.title,
    where: 'sole developer',
    when: `${scout.data.start.getFullYear()} · ${scout.data.status}`,
    desc: scout.data.tagline,
  },
];
---

<Base bare={true} title={site.title}>
  <div class="mx-auto w-full max-w-6xl px-5 lg:px-8">
    <!-- Mobile wayfinding: one quiet row -->
    <nav
      class="lg:hidden flex flex-wrap items-baseline gap-x-5 gap-y-1 border-b border-line py-4 font-sans text-sm"
      aria-label="Site"
    >
      {site.nav.map((n) => (
        <a href={n.href} class="text-muted transition-colors hover:text-ink">{n.label}</a>
      ))}
    </nav>

    <div class="lg:grid lg:grid-cols-[10.5rem_1fr] lg:gap-12 xl:gap-16">
      <!-- Structural left margin: marginalia rail -->
      <header class="hidden lg:flex flex-col pt-10" aria-label="Site">
        <nav aria-label="Primary">
          <ul class="space-y-1.5 font-sans text-[0.92rem]">
            {site.nav.map((n) => (
              <li>
                <a href={n.href} class="text-muted transition-colors hover:text-ink">{n.label}</a>
              </li>
            ))}
          </ul>
        </nav>
        <p class="mt-10 font-sans text-xs text-muted">Corvallis, Oregon</p>
      </header>

      <!-- Main column, hung on the rule -->
      <div class="pt-8 pb-24 lg:border-l lg:border-line lg:pl-11 lg:pt-10">
        <BitSignature class="mb-5" />

        <h1 class="headline">
          <span class="block">Rodrigo Flores</span>
          <span class="surname block text-accent">Bertolotti</span>
        </h1>

        <p class="standfirst mt-6 max-w-[56ch]">{site.focus}</p>

        <p class="mt-5 max-w-[75ch]">{site.education.line}</p>
        <p class="mt-1 max-w-[75ch] font-sans text-sm text-muted">{site.education.prior}</p>

        <ul class="mt-6 flex flex-wrap gap-x-6 gap-y-1.5 font-sans text-[0.9rem]" aria-label="Contact">
          {site.contacts.map((c) => (
            <li>
              <a href={c.href} class="contact-link" aria-label={c.label}>{c.value}</a>
            </li>
          ))}
        </ul>

        <section class="mt-8" aria-labelledby="selected-work">
          <h2 id="selected-work" class="font-sans text-sm font-medium text-muted">Selected work</h2>
          <ul class="mt-3 border-t border-line">
            {entries.map((e) => (
              <li class="entry border-b border-line">
                <a href={e.href} class="block py-3">
                  <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-0.5">
                    <h3 class="text-[1.25rem] leading-snug font-semibold">
                      <span class="entry-title">{e.title}</span>
                      <span class="font-normal text-muted"> — {e.where}</span>
                    </h3>
                    <span class="font-mono text-xs whitespace-nowrap text-muted">{e.when}</span>
                  </div>
                  <p class="mt-1 max-w-[68ch] text-[0.97rem] text-muted">{e.desc}</p>
                </a>
              </li>
            ))}
          </ul>
        </section>
      </div>
    </div>
  </div>
</Base>

<style>
  /* Oversized STIX thesis: committed scale contrast, tight but legal. */
  .headline {
    font-size: clamp(2.5rem, 7vw, 5rem);
    font-weight: 600;
    line-height: 1.04;
    letter-spacing: -0.025em;
  }

  /* The one typographic risk: the surname breaks ranks, hanging left across
     the structural rule. bg slices the rule so the word punches through it. */
  @media (min-width: 1024px) {
    .surname {
      margin-left: -4.5rem; /* column pl is 2.75rem → crosses the rule by 1.75rem */
      background: var(--c-bg);
    }
  }

  .standfirst {
    font-size: clamp(1.125rem, 1.05rem + 0.8vw, 1.3rem);
    line-height: 1.5;
  }

  .contact-link {
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.32em;
    text-decoration-color: var(--c-line);
    transition: text-decoration-color 120ms ease;
  }
  .contact-link:hover {
    text-decoration-color: var(--c-accent);
  }

  .entry a:hover .entry-title,
  .entry a:focus-visible .entry-title {
    text-decoration-line: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.22em;
  }
</style>
