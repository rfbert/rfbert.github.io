---
/**
 * Art-direction variant 2 — RESEARCH-PAPER-MINIMAL.
 * The homepage composed as a web-native article: centered front matter
 * (title, author line, correspondence), an abstract, Figure 1, numbered
 * document sections, citation-style entries, end-matter contact block.
 */
import Base from '../../layouts/Base.astro';
import BitSignature from '../../components/BitSignature.astro';
import { getCollection, getEntry } from 'astro:content';
import { site } from '../../data/site';

const research = (await getCollection('research')).sort(
  (a, b) => a.data.order - b.data.order,
);
const mibanco = await getEntry('experience', 'mibanco');
const scout = await getEntry('projects', 'internship-scout');
if (!mibanco || !scout) throw new Error('Missing required content entries');

const yr = (d: Date) => d.getUTCFullYear();
const refOffset = research.length;
---

<Base bare={true} title={site.title}>
  <article class="paper mx-auto w-full max-w-[44rem] px-5 sm:px-6 pt-4 pb-16">
    <!-- Running head: the paper's quiet wayfinding -->
    <header
      class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 border-b border-line pb-3 font-sans text-[0.8125rem]"
    >
      <span class="font-mono text-muted">rfbert.github.io</span>
      <nav aria-label="Site" class="flex flex-wrap justify-end gap-x-4 gap-y-1">
        {site.nav.map((n) => (
          <a href={n.href} class="text-muted transition-colors hover:text-ink">{n.label}</a>
        ))}
      </nav>
    </header>

    <!-- Title block: name as title, degree line as author/affiliation line -->
    <div class="mt-9 text-center sm:mt-11">
      <h1 class="font-serif text-[clamp(1.9rem,1.15rem+3.2vw,2.75rem)] font-semibold leading-[1.12]">
        {site.name}
      </h1>
      <p class="mx-auto mt-3 max-w-[36rem] text-[0.9375rem] leading-normal text-muted">
        {site.education.line}
      </p>
      <p class="mt-3 font-sans text-sm">
        {site.contacts.map((c, i) => (
          <>
            <a
              href={c.href}
              class="text-ink underline decoration-line underline-offset-[0.3em] transition-colors hover:decoration-accent"
            >{c.label}</a>
            {i < site.contacts.length - 1 && (
              <span class="mx-1.5 text-muted" aria-hidden="true">·</span>
            )}
          </>
        ))}
      </p>
    </div>

    <!-- Abstract: the one aesthetic risk — set oversized, run-in label, framed by rules -->
    <section aria-label="Abstract" class="mt-9 border-y border-line py-5">
      <p class="font-serif text-[clamp(1.125rem,1rem+0.6vw,1.3rem)] leading-[1.6]">
        <span class="font-semibold">Abstract&thinsp;—&thinsp;</span><em>{site.focus}</em>
      </p>
    </section>

    <!-- Figure 1: the site signature, captioned as honest paper grammar -->
    <figure class="mt-7 text-center">
      <BitSignature />
      <figcaption class="mt-1 font-sans text-xs leading-normal text-muted">
        <span class="font-medium text-ink">Figure 1.</span>
        A flipped bit, caught — the silent corruption this research detects and corrects.
      </figcaption>
    </figure>

    <!-- 1. Research -->
    <section class="mt-9">
      <h2 class="font-serif text-[1.2rem] font-semibold">
        <span class="text-accent">1.</span>&ensp;Research
      </h2>
      <ol class="mt-4 space-y-4">
        {research.map((r, i) => (
          <li class="grid grid-cols-[2.25rem_1fr]">
            <span class="pt-[0.15rem] font-mono text-sm text-muted">[{i + 1}]</span>
            <div>
              <p class="font-serif text-[1.05rem] font-medium leading-snug">{r.data.title}.</p>
              <p class="mt-0.5 text-[0.9375rem] leading-snug text-muted">
                {r.data.role}, {r.data.lab}.
              </p>
              <p class="mt-1 font-mono text-[0.8125rem] leading-normal text-muted">
                {yr(r.data.start)}–&ensp;·&ensp;<span class="text-ink">{r.data.statusLabel}</span>
              </p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <!-- 2. Selected work -->
    <section class="mt-9">
      <h2 class="font-serif text-[1.2rem] font-semibold">
        <span class="text-accent">2.</span>&ensp;Selected work
      </h2>
      <ol class="mt-4 space-y-4">
        <li class="grid grid-cols-[2.25rem_1fr]">
          <span class="pt-[0.15rem] font-mono text-sm text-muted">[{refOffset + 1}]</span>
          <div>
            <p class="font-serif text-[1.05rem] font-medium leading-snug">
              {mibanco.data.role} — {mibanco.data.organization} ({mibanco.data.parent}), {mibanco.data.location}.
            </p>
            <p class="mt-0.5 text-[0.9375rem] leading-snug text-muted">
              Built a parallelized audio-ingestion and speech-to-text pipeline on Databricks
              using Azure AI model endpoints, for integration into production workflows at
              Peru's largest microfinance bank.
            </p>
            <p class="mt-1 font-mono text-[0.8125rem] leading-normal text-muted">
              {yr(mibanco.data.start)}&ensp;·&ensp;{mibanco.data.stack.join(' · ')}
            </p>
          </div>
        </li>
        <li class="grid grid-cols-[2.25rem_1fr]">
          <span class="pt-[0.15rem] font-mono text-sm text-muted">[{refOffset + 2}]</span>
          <div>
            <p class="font-serif text-[1.05rem] font-medium leading-snug">
              {scout.data.title} — {scout.data.role}.
            </p>
            <p class="mt-0.5 text-[0.9375rem] leading-snug text-muted">
              {scout.data.tagline}.
            </p>
            <p class="mt-1 font-mono text-[0.8125rem] leading-normal text-muted">
              {yr(scout.data.start)}&ensp;·&ensp;{scout.data.stack.join(' · ')}{scout.data.repoNote && (
                <>&ensp;·&ensp;{scout.data.repoNote.toLowerCase()}</>
              )}
            </p>
          </div>
        </li>
      </ol>
    </section>

    <!-- 3. Contact: end matter -->
    <section class="mt-9">
      <h2 class="font-serif text-[1.2rem] font-semibold">
        <span class="text-accent">3.</span>&ensp;Contact
      </h2>
      <ul class="mt-4 space-y-2">
        {site.contacts.map((c) => (
          <li class="grid items-baseline gap-x-4 sm:grid-cols-[7rem_1fr]">
            <span class="font-sans text-[0.8125rem] text-muted">{c.label}</span>
            <a
              href={c.href}
              class="w-fit font-mono text-[0.9rem] text-ink underline decoration-line underline-offset-[0.3em] transition-colors hover:decoration-accent"
            >{c.value}</a>
          </li>
        ))}
      </ul>
    </section>

    <!-- Footnotes -->
    <aside class="mt-11" aria-label="Notes">
      <div class="w-16 border-t border-line"></div>
      <p class="mt-2 font-serif text-[0.875rem] leading-normal text-muted">
        {site.education.coursework}
      </p>
      <p class="mt-1 font-serif text-[0.875rem] leading-normal text-muted">
        {site.education.prior}
      </p>
    </aside>

    <!-- End of document -->
    <div class="mt-12 select-none text-center text-muted" aria-hidden="true">∎</div>
  </article>
</Base>

<style>
  /* The figure caption speaks for the figure; suppress the component's inline
     annotation so the motif's phrase appears exactly once. */
  .paper figure :global(.bit-caption) {
    display: none;
  }
</style>
