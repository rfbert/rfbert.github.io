---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { site } from '../../data/site';

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' });
const span = (start: Date, end?: Date) => {
  if (!end) return `${fmt(start)} – present`;
  if (fmt(start) === fmt(end)) return fmt(start);
  return `${fmt(start)} – ${fmt(end)}`;
};

const experience = await getCollection('experience');
const projects = await getCollection('projects');
const research = (await getCollection('research')).sort((a, b) => a.data.order - b.data.order);

const mibanco = experience.find((e) => e.id === 'mibanco')!;
const lab = experience.find((e) => e.id === 'true-ai-lab')!;
const foundation = experience.find((e) => e.id === 'osu-foundation')!;
const ta = experience.find((e) => e.id === 'usmp-ta')!;
const scout = projects.find((p) => p.id === 'internship-scout')!;
const automation = projects.find((p) => p.id === 'ai-productivity')!;

// One-line facts condensed from the entries' own bullets — nothing invented.
const proof = [
  {
    org: mibanco.data.organization,
    parent: mibanco.data.parent,
    role: mibanco.data.role,
    fact: "Parallelized audio-ingestion and speech-to-text pipeline on Databricks with Azure AI model endpoints, built for production workflows at Peru's largest microfinance bank.",
    stack: mibanco.data.stack,
    dates: span(mibanco.data.start, mibanco.data.end),
  },
  {
    org: lab.data.organization,
    parent: lab.data.parent,
    role: lab.data.role,
    fact: 'Robustness of 1B–8B Llama 3 models under hardware bit-flip faults: a gradient-guided attack framework and benchmarking of 7 defenses, run on an A100 Slurm cluster.',
    stack: lab.data.stack,
    dates: span(lab.data.start, lab.data.end),
  },
  {
    org: scout.data.title,
    parent: undefined,
    role: scout.data.role,
    fact: `${scout.data.tagline}.`,
    stack: scout.data.stack,
    dates: span(scout.data.start, scout.data.end),
  },
];

const papers = await Promise.all(
  research.map(async (entry) => ({ entry, Content: (await render(entry)).Content }))
);

const also = [
  {
    org: foundation.data.organization,
    note: foundation.data.role,
    dates: span(foundation.data.start, foundation.data.end),
  },
  {
    org: ta.data.organization,
    note: ta.data.role,
    dates: span(ta.data.start, ta.data.end),
  },
  {
    org: automation.data.title,
    note: automation.data.tagline,
    dates: span(automation.data.start, automation.data.end),
  },
];

const bitsLeft = ['1', '0', '1', '1', '0'];
const bitsRight = ['1', '0', '0', '1', '0', '1'];
---

<Base bare={true} title={site.title}>
  <div class="mx-auto w-full max-w-5xl px-5 sm:px-8">
    <header class="flex items-baseline justify-between gap-6 border-b border-line py-3.5">
      <span class="hidden font-mono text-xs text-muted sm:block">rfbert.github.io</span>
      <nav aria-label="Site" class="flex flex-wrap gap-x-5 gap-y-1 font-sans text-sm text-muted">
        {site.nav.map((item) => (
          <a href={item.href} class="transition-colors hover:text-ink">{item.label}</a>
        ))}
      </nav>
    </header>

    <section class="pt-9 sm:pt-11">
      {/* The signature, restaged as the opening instrument reading: an error struck
          in line, the correction written above it — the way a lab notebook keeps its record. */}
      <figure
        class="m-0"
        role="img"
        aria-label="A row of bits in which one silently flipped bit is caught: the error struck through in ochre, the corrected value written above it — the subject of my research."
      >
        <div class="bit-row select-none font-mono text-ink" aria-hidden="true">
          {bitsLeft.map((b) => <span>{b}</span>)}
          <span class="bit-cell">
            <span class="bit-clean">0</span>
            <span class="bit-err text-accent">1</span>
            <span class="bit-fix">0</span>
          </span>
          {bitsRight.map((b) => <span>{b}</span>)}
        </div>
        <figcaption class="bit-caption mt-3 font-sans text-xs text-muted" aria-hidden="true">
          a flipped bit, caught
        </figcaption>
      </figure>

      <h1 class="mt-8 font-serif text-[clamp(2.125rem,4.6vw,3.25rem)]/[1.08] font-semibold tracking-[-0.015em]">
        {site.name}
      </h1>
      <p class="mt-4 max-w-[56ch] font-serif text-[1.1875rem]/[1.6] sm:text-[1.3125rem]/[1.6]">
        {site.focus}
      </p>
      <p class="mt-2.5 max-w-[68ch] text-[0.9375rem]/[1.65] text-muted">
        {site.education.line}
      </p>

      <ul class="mt-7 flex flex-wrap gap-x-10 gap-y-3 border-y border-line py-3.5">
        {site.contacts.map((c) => (
          <li>
            <a href={c.href} class="group inline-flex flex-col">
              <span class="font-sans text-[0.6875rem]/[1.4] text-muted">{c.label}</span>
              <span class="font-mono text-sm text-ink underline-offset-4 group-hover:underline group-hover:decoration-accent">
                {c.value}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="mt-9 sm:mt-10">
      <div class="flex items-center gap-5">
        <h2 class="shrink-0 font-serif text-lg font-medium italic">Selected work</h2>
        <span class="h-px flex-1 bg-line" aria-hidden="true"></span>
      </div>
      <ul class="mt-4 border-b border-line">
        {proof.map((row) => (
          <li class="grid gap-x-8 gap-y-1.5 border-t border-line py-4 md:grid-cols-[11.5rem_minmax(0,1fr)_auto]">
            <div class="font-sans text-sm/snug font-medium">
              {row.org}
              {row.parent && <span class="block text-xs font-normal text-muted">{row.parent}</span>}
            </div>
            <div class="max-w-[60ch]">
              <p class="font-serif font-medium">{row.role}</p>
              <p class="mt-1 text-[0.9375rem]/[1.6] text-muted">{row.fact}</p>
            </div>
            <div class="font-mono text-xs/[1.7] text-muted md:max-w-[13rem] md:text-right">
              {row.dates}
              <span class="mt-0.5 block">{row.stack.join(' · ')}</span>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <section class="mt-14">
      <div class="flex items-center gap-5">
        <h2 class="shrink-0 font-serif text-lg font-medium italic">Research</h2>
        <span class="h-px flex-1 bg-line" aria-hidden="true"></span>
      </div>
      <p class="mt-3 font-sans text-xs text-muted">{research[0].data.lab}</p>
      <ul class="mt-3 border-b border-line">
        {papers.map(({ entry, Content }) => (
          <li class="grid gap-x-8 gap-y-2 border-t border-line py-6 md:grid-cols-[minmax(0,1fr)_auto]">
            <div class="max-w-[62ch]">
              <h3 class="font-serif text-lg/snug font-medium">{entry.data.title}</h3>
              <p class="mt-1 font-sans text-xs text-muted">
                {entry.data.role} · {entry.data.area}
              </p>
              <div class="paper-body mt-3 text-[0.9375rem]/[1.65] text-muted">
                <Content />
              </div>
            </div>
            <p class="font-mono text-xs text-muted md:text-right">
              <span class="mr-1.5 inline-block size-1.5 -translate-y-px rounded-full bg-accent" aria-hidden="true"></span>
              {entry.data.statusLabel}
            </p>
          </li>
        ))}
      </ul>
    </section>

    <section class="mt-14">
      <div class="flex items-center gap-5">
        <h2 class="shrink-0 font-serif text-lg font-medium italic">Education</h2>
        <span class="h-px flex-1 bg-line" aria-hidden="true"></span>
      </div>
      <p class="mt-4 max-w-[68ch]">{site.education.line}</p>
      <p class="mt-2 max-w-[68ch] text-[0.9375rem]/[1.65] text-muted">{site.education.coursework}</p>
      <p class="mt-1.5 max-w-[68ch] text-[0.9375rem]/[1.65] text-muted">{site.education.prior}</p>
    </section>

    <section class="mt-14">
      <div class="flex items-center gap-5">
        <h2 class="shrink-0 font-serif text-lg font-medium italic">Also</h2>
        <span class="h-px flex-1 bg-line" aria-hidden="true"></span>
      </div>
      <ul class="mt-4 border-b border-line">
        {also.map((row) => (
          <li class="grid gap-x-8 gap-y-0.5 border-t border-line py-3 md:grid-cols-[11.5rem_minmax(0,1fr)_auto]">
            <span class="font-sans text-sm/snug font-medium">{row.org}</span>
            <span class="max-w-[60ch] text-[0.9375rem]/[1.6] text-muted">{row.note}</span>
            <span class="font-mono text-xs/[1.7] text-muted md:text-right">{row.dates}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="mt-14">
      <div class="flex items-center gap-5">
        <h2 class="shrink-0 font-serif text-lg font-medium italic">Recognition</h2>
        <span class="h-px flex-1 bg-line" aria-hidden="true"></span>
      </div>
      <ul class="mt-4 grid gap-x-10 gap-y-3.5 border-t border-line pt-5 sm:grid-cols-2">
        {site.awards.map((a) => (
          <li>
            <span class="text-[0.9375rem]/[1.5]">{a.title}</span>
            <span class="mt-0.5 block font-sans text-xs text-muted">{a.detail}</span>
          </li>
        ))}
      </ul>
    </section>

    <footer class="mt-16 mb-2 border-t border-line py-7">
      <div class="flex flex-wrap items-baseline justify-between gap-x-10 gap-y-3">
        <p class="font-serif text-sm text-muted">© 2026 Rodrigo Flores Bertolotti</p>
        <ul class="flex flex-wrap gap-x-6 gap-y-2">
          {site.contacts.map((c) => (
            <li>
              <a href={c.href} class="font-mono text-xs text-muted transition-colors hover:text-ink">
                {c.value}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </footer>
  </div>
</Base>

<style>
  /* --- The signature, enlarged: one bit flips, is struck, and the correction
         is written above the line — a notebook record, kept honestly. --- */
  .bit-row {
    display: flex;
    align-items: baseline;
    gap: clamp(0.5rem, 2vw, 1rem);
    padding-top: 0.85em;
    font-size: clamp(1.375rem, 3.6vw, 2.125rem);
    line-height: 1;
  }

  .bit-cell {
    position: relative;
    width: 1ch;
  }

  .bit-clean {
    display: inline-block;
    animation: bit-clean 7.5s ease-out 1 both;
  }

  .bit-err {
    position: absolute;
    left: 0;
    top: 0;
    opacity: 0;
    animation: bit-err 7.5s ease-out 1 both;
  }

  /* handwritten strike through the error */
  .bit-cell::after {
    content: '';
    position: absolute;
    left: -14%;
    right: -14%;
    top: 52%;
    height: 0.075em;
    background: var(--c-accent);
    transform: rotate(-7deg) scaleX(0);
    transform-origin: left center;
    animation: bit-strike 7.5s ease-out 1 both;
  }

  /* the correction, written small above the line */
  .bit-fix {
    position: absolute;
    left: 50%;
    top: -1.15em;
    font-size: 0.58em;
    font-weight: 500;
    color: var(--c-ink);
    opacity: 0;
    transform: translate(-50%, 0.3em);
    animation: bit-fix 7.5s ease-out 1 both;
  }

  .bit-caption {
    opacity: 0;
    animation: bit-caption 7.5s ease-out 1 both;
  }

  @keyframes bit-clean {
    0%, 22% { opacity: 1; }
    27%, 100% { opacity: 0; }
  }
  @keyframes bit-err {
    0%, 22% { opacity: 0; }
    27%, 54% { opacity: 1; }
    66%, 100% { opacity: 0.72; }
  }
  @keyframes bit-strike {
    0%, 50% { transform: rotate(-7deg) scaleX(0); }
    62%, 100% { transform: rotate(-7deg) scaleX(1); }
  }
  @keyframes bit-fix {
    0%, 60% { opacity: 0; transform: translate(-50%, 0.3em); }
    72%, 100% { opacity: 1; transform: translate(-50%, 0); }
  }
  @keyframes bit-caption {
    0%, 64% { opacity: 0; }
    78%, 100% { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .bit-clean { opacity: 0; animation: none; }
    .bit-err { opacity: 0.72; animation: none; }
    .bit-cell::after { transform: rotate(-7deg) scaleX(1); animation: none; }
    .bit-fix { opacity: 1; transform: translate(-50%, 0); animation: none; }
    .bit-caption { opacity: 1; animation: none; }
  }

  /* rendered markdown inside research rows */
  .paper-body :global(p + p) {
    margin-top: 0.7em;
  }
</style>
